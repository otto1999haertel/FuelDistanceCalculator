            // In DOMContentLoaded hinzufügen:
            document.querySelectorAll('input[type="range"][data-output-id]').forEach(slider => {
                slider.addEventListener('input', function () {
                    const outputId = this.getAttribute('data-output-id');
                    const output = document.getElementById(outputId);
                    if (output) output.textContent = this.value + ' km';
                });
            });


            const stationContainer = document.getElementById('stationListContainer');
            if (stationContainer) {
                stationContainer.addEventListener('click', function(e) {
