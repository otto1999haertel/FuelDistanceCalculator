@page
@using FuelDistanceCalculator.Constants
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JEP2Q2QZMH"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-JEP2Q2QZMH');
</script>


<meta name="viewport" content="width=device-width, initial-scale=1.0">
<div class="text-center">
    <h1 class="display-4">Willkommen bei FuelGo</h1>
    <p>Finde die optimale Tankstelle oder vergleiche die durchschnittlichen Spritkosten zwischen zwei Orten</p>
</div>

<div class="container">
    <form method="post">
        <div class="row justify-content-center">
            <!-- Eingabefelder für globale Werte - mittig zentriert -->
            <div class="col-md-6">
                <h3>Globale Eingabewerte</h3>

                <!-- Dropdown für Spritart -->
                <div class="mb-3">
                    <label asp-for="SelectedFuelType" class="form-label">Spritart</label>
                    <select asp-for="SelectedFuelType" class="form-select" asp-items="@(FuelTypeHelper.FuelTypeNames.Select(kvp => new SelectListItem
                                                                           {
                                                                               Value = kvp.Key.ToString(),
                                                                               Text = kvp.Value
                                                                           }))">
                    </select>
                </div>

                <!-- Eingabe für Tankmenge -->
                <div class="form-group">
                    <label for="fuelAmount">Tankmenge (@Model.VolumeUnit)</label>
                    <input type="text" id="FuelAmountDisplay" class="form-control" required
                        onblur="calculateAndStore(this)" value="@Model.FuelAmount" />
                    <input type="hidden" id="FuelAmount" name="FuelAmount" value="@Model.FuelAmount" />

                    <script>
                    </script>

                </div>

                <!-- Preis pro Kilometer -->
                <div class="row">
                    <div class="col-md-6">
                        <!-- Preis pro Kilometer -->
                        <div class="form-group">
                            <label for="PricePerKm">Preis pro Kilometer (€)</label>
                            <input class="form-control" id="PricePerKm" name="PricePerKm" required
                                onblur="formatPricePerKm(this)" asp-for="PricePerKm" value="@Model.PricePerKm" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="SelectedCarType">Fahrzeugtyp </label>
                            <span>
                                <a href="https://www.adac.de/rund-ums-fahrzeug/auto-kaufen-verkaufen/autokosten/uebersicht/"
                                    target="_blank">
                                    (ADAC Vorschlag)</a><sup><a href="#fn1" id="ref1">1</a></sup>
                            </span>
                            <input type="text" class="form-control" id="CarType" placeholder="Fahrzeugtyp suchen..."
                                list="CarTypeList" value="@Model.SelectedCarType" asp-for="SelectedCarType">
                            <div id="suggestions" class="suggestions-box"></div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group d-flex justify-content-center radio-spacing">
            <label>
                <input type="radio" name="SelectInputMode" id="autoInput" value="Auto" @(Model.SelectInputMode ==
                                                                                                           InputMode.auto ? "checked" : "") onchange="toggleInputMethod(this)"> Optimale Suche
            </label>
            <label>
                <input type="radio" name="SelectInputMode" id="manualInput" value="Manual" @(Model.SelectInputMode ==
                                                                                                               InputMode.man ? "checked" : "") onchange="toggleInputMethod(this)"> Standortvergleich
            </label>
        </div>

        <!-- Manuelle Eingabe (wird ausgeblendet, wenn Automatische Auswahl gewählt wird) -->
        <div id="manualInputFields" style="display:@(Model.SelectInputMode == InputMode.man ? "block" : "none")">
            <div class="row">
                <!-- Tankstelle 1 Eingabefelder - links ausgerichtet -->
                <div class="col-md-5 offset-md-1">
                    <label for="NamePlace1">Standort 1 (PLZ/ Straße, Ort)</label>
                    <input type="text" id="NamePlace1" class="form-control" placeholder="Geben Sie einen Ort ein"
                        asp-for="NamePlace1" value="@Model.NamePlace1">
                </div>
                <div class="col-md-5">
                    <label for="RadiusPlace1">Radius (km)</label>
                    <input type="number" id="RadiusPlace1" class="form-control" placeholder="Radius in km"
                        asp-for="RadiusPlace1" value="@Model.RadiusPlace1">
                </div>

                <!-- Tankstelle 2 Eingabefelder - rechts ausgerichtet -->
                <div class="col-md-5 offset-md-1">
                    <label for="NamePlace2">Standort 2 (PLZ/ Straße, Ort)</label>
                    <input type="text" id="NamePlace2" class="form-control" placeholder="Geben Sie einen Ort ein"
                        asp-for="NamePlace2" value="@Model.NamePlace2">
                </div>
                <div class="col-md-5">
                    <label for="RadiusPlace2">Radius (km)</label>
                    <input type="number" id="RadiusPlace2" class="form-control" placeholder="Radius in km"
                        asp-for="RadiusPlace2" value="@Model.RadiusPlace2">
                </div>
            </div>
            <!-- Berechnen-Button -->
             <div class="row justify-content-center mt-3">
                <button type="submit" class="btn btn-primary mx-2" style="width: 120px"
                    asp-page-handler="CalculateAverageCost">
                    Berechnen
                </button>
             </div>
        </div>

    <!-- Automatische Auswahl (wird angezeigt, wenn Automatische Auswahl gewählt wird) -->
    <div id="autoInputFields" style="display:@(Model.SelectInputMode == InputMode.auto ? "block" : "none")">
    <!-- Automatische Eingabe für Standort und Radius -->
    <div class="row">
        <div class="col-md-5 offset-md-1">
            <label for="generalLocation">Standort (PLZ/ Straße, Ort)</label>
            <input type="text" id="generalLocation" class="form-control" placeholder="Geben Sie einen Ort ein"
                asp-for="Place" value="@Model.Place">
        </div>
        <div class="col-md-5">
            <label for="generalRadius">Radius (km)</label>
            <input type="number" id="generalRadius" class="form-control" placeholder="Radius in km" min="1"
                asp-for="Radius" value="@Model.Radius">
        </div>
    </div>
    <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-primary mx-2" style="width: 120px"
            asp-page-handler="Search">Suchen</button>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-6" style="padding: 20px;">
            @if (Model.CheapestResultStations.Any())
            {
                @* TODO Switch betwwen list and map *@
                <ul class="station-list">
                    @foreach (var station in Model.CheapestResultStations)
                    {
                        <li class="station-item">
                            <div class="station-summary" onclick="toggleDetails(this)">
                                <strong>@station.Name</strong> - Gesamtkosten:
                                @(Model.ToDisplay(station.CalculateTotalCost(@Model.FuelAmount, @Model.PricePerKm).ToString()))
                                €
                            </div>
                            <div class="station-details" style="display:none;">
                                <p>Einzelpreis pro Liter: @Model.ToDisplay(station.Price.ToString())€</p>
                                <p>Entfernung: @Model.ToDisplay(station.Distance.ToString()) km</p>
                                <p>Ort:
                                    <a href="https://www.google.com/maps?q=@station.Place,@station.Street+@station.HouseNumber"
                                        target="_blank">
                                        @station.Place, @station.Street @station.HouseNumber
                                    </a>
                                </p>

                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>Keine offenen Tankstellen im Radius gefunden.</p>
            }
        </div>
        </div>
        
    </div>
    </form>
</div>
<!-- JavaScript für die Eingabe-Auswahl-Steuerung -->
<script>
    function updateRadius(input) {
        // Wenn der Benutzer das Feld verlässt und nichts eingegeben hat, verwende den Platzhalter als Standard
        if (!input.value.trim()) {
            input.value = input.placeholder;  // Falls leer, setze den Platzhalterwert
        }

        // Aktualisiere das Modell im Hintergrund
        var radiusPlace1 = document.querySelector('input[name="RadiusPlace1"]');
        var radiusPlace2 = document.querySelector('input[name="RadiusPlace2"]');
        if (input.value>0) {
            radiusPlace1.value = input.value; 
            radiusPlace2.value = input.value;  // Das Modell im Hintergrund aktualisieren
        }
    }

    function calculateAndStore(input) {
        try {
            let expression = input.value.replace(",", "."); // Ersetze Komma durch Punkt
            if (/^[0-9+\-*/().\s]*$/.test(expression)) {
                let result = eval(expression); // Berechne den Ausdruck
                if (!isNaN(result)) {
                    input.value = result; // Zeige das Ergebnis im Eingabefeld an
                    document.getElementById("FuelAmount").value = result; // Speichere das Ergebnis im versteckten Feld für das Model
                }
            }
        } catch (e) {
            console.error("Ungültiger Ausdruck:", e);
        }
    }

    function toggleInputMethod(radio) {
        var manualFields = document.getElementById("manualInputFields");
        var autoFields = document.getElementById("autoInputFields");
        if (radio.value === "Manual") {
            manualFields.style.display = "block";
            autoFields.style.display = "none";
        }
        else {
            manualFields.style.display = "none";
            autoFields.style.display = "block";
        }
    }

    function toggleDetails(element) {
        // Holen des Elements, das die Details enthält
        var details = element.nextElementSibling;

        // Wenn die Details sichtbar sind, verstecke sie, sonst zeige sie an
        if (details.style.display === "none" || details.style.display === "") {
            details.style.display = "block";
        } else {
            details.style.display = "none";
        }
    }

    function formatPricePerKm(input) {
        let expression = input.value.replace(",", ".");
        document.getElementById("PricePerKm").value = expression;
    }

    $(function () {
        let debounceTimer = null;
        const $input = $("#CarType");
        const $suggestionsBox = $("#suggestions");

        // Input-Feld beobachten
        $input.on('input', function () {
            clearTimeout(debounceTimer);
            const searchTerm = $(this).val().trim();
            $suggestionsBox.empty().hide();

            debounceTimer = setTimeout(function () {
                if (searchTerm.length > 0) {
                    $.ajax({
                        url: '?handler=FilterCarTypes',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: searchTerm },
                        success: function (data) {
                            data.filteredCars.forEach(car => {
                                const item = $('<div class="suggestion-item"></div>').text(car);
                                $suggestionsBox.append(item);
                            });
                            if (data.filteredCars.length > 0) {
                                $suggestionsBox.show();
                            }
                        },
                        error: function () {
                            console.error("Fehler bei der Filterabfrage");
                        }
                    });
                }
            }, 300); // <-- Debounce von 300 ms
        });

        // Nur EIN zentraler Click-Handler für dynamische Vorschläge
        $suggestionsBox.on('click', '.suggestion-item', function () {
            const selectedCarType = $(this).text();
            $input.val(selectedCarType);
            $suggestionsBox.empty().hide();
            if (selectedCarType === "") {
                $('#PricePerKm').val('');
                return;
            }

            $.ajax({
                url: '?handler=PricePerKm',
                type: 'GET',
                data: { carType: selectedCarType },
                success: function (data) {
                    $('#PricePerKm').val(data.pricePerKm);
                },
                error: function () {
                    console.error("Fehler beim Abrufen von PricePerKm");
                }
            });
        });

        // Click außerhalb der Box: Suggestions schließen
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#suggestions, #CarType').length) {
                $suggestionsBox.empty().hide();
            }
        });
    });

    $(function () {
        var type = '@TempData["ToastType"]';
        var message = '@TempData["ToastMessage"]';

        if (message) {
            toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-bottom-right" // ⬅️ hier wird die Position gesetzt
            };
            toastr[type](message);
        }
    });


</script>
<!-- Berechnungen oder Ergebnisse - unter dem Berechnen Button -->
    @if(Model.SelectInputMode == InputMode.man && (Model.AverageCostPlace1 > 0 || Model.AverageCostPlace2 > 0)){
    <div id="averageCost" class="mt-4 text-center">
        <h4>Ergebnisse:</h4>
        <p>@Model.NamePlace1 - @(Model.AverageCostPlace1 > 0 ? $"Durchschnittspreis: {Model.ToDisplay(Model.AverageCostPlace1.ToString("0.00"))} €" : "Keine Preise verfügbar")</p>
        <p>@Model.NamePlace2 - @(Model.AverageCostPlace2 > 0 ? $"Durchschnittspreis: {Model.ToDisplay(Model.AverageCostPlace2.ToString("0.00"))} €" : "Keine Preise verfügbar")</p>
    </div>
    }
<hr>
<ol>
    <li id="fn1">
        Herbst/ Winter 2024
    </li>
</ol>
