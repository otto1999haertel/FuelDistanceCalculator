@page
@using FuelDistanceCalculator.Constants
@using System.Globalization
@using FuelDistanceCalculator.Extensions
@model IndexModel
@{
    ViewData["Title"] = "FuelGo";
    var culture = new CultureInfo("de-DE");

    // Erweiterte Einstellungen aufgeklappt lassen, falls Werte drin sind
    var advancedHasValue =
        !string.IsNullOrWhiteSpace(Model.StationBrand)
        || !string.IsNullOrWhiteSpace(Model.DiscountPercentOrAbsolute)
        || !string.IsNullOrWhiteSpace(Model.SelectedCarType);
}

<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<script src="~/lib/leaflet/leaflet.js"></script>
<script nonce="@Html.CspNonce()">
    window.dataLayer = window.dataLayer || [];
</script>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- HERO -->
<div class="hero-section text-center">
    <h1 class="display-5">Willkommen bei FuelGo</h1>
    <p class="lead">Finde die optimale Tankstelle oder vergleiche Kraftstoffpreise zwischen Orten</p>
</div>

<div class="container">
    <form method="post">
        @Html.AntiForgeryToken()

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">

                <!-- HAUPT-EINGABE-CARD -->
                <div class="card main-card mb-4">
                    <div class="card-body p-4">
                        @await Html.PartialAsync("_ModeTabsComponent", Model)

                        @await Html.PartialAsync("_AdvancedOptionsComponent", Model)

                        @await Html.PartialAsync("_OilPriceDisplayComponent", Model)

                        @await Html.PartialAsync("_AutoSearchModeComponent", Model)

                        @await Html.PartialAsync("_ComparisonModeLocationsComponent", Model)

                    </div>
                </div>

                <!-- ERGEBNIS-CARD: OPTIMALE SUCHE -->
                @await Html.PartialAsync("_SearchResultsComponent", Model)

                <!-- ERGEBNIS-CARD: STANDORTVERGLEICH -->
                @await Html.PartialAsync("_AverageCostDisplayComponent", Model)

            </div>
        </div>
    </form>

    <!-- FOOTNOTE -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <hr>
            <ol class="footer-note">
                <li id="fn1">@Model.DataSourceDate</li>
            </ol>
        </div>
    </div>
</div>

<script nonce="@Html.CspNonce()">
    let mapInitialized = false;
    let map;
    let Tiles;
    let locationIndex = @Model.NamePlaces.Count;

    function updateFuel(value) {
        document.getElementById('fuelAmountValue').textContent = String(value).replace('.', ',') + ' l';
    }

    function updateMax(value) {
        document.getElementById('FuelAmountRange').max = value;
        localStorage.setItem("maxVolume", value);
    }

    function toggleInputMethod(radio) {
        var manualFields = document.getElementById("manualInputFields");
        var autoFields = document.getElementById("autoInputFields");
        var averageCost = document.getElementById("averageCost");
        var autoResults = document.getElementById("autoResults");

        // Tab-Styling aktualisieren
        document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
        const label = document.querySelector(`label[for="${radio.id}"]`);
        if (label) label.classList.add('active');

        if (radio.value === "man") {
            manualFields.style.display = "block";
            autoFields.style.display = "none";
            if (autoResults) autoResults.style.display = "none";
            if (averageCost != null) averageCost.style.display = "block";
        }
        if (radio.value === "auto") {
            manualFields.style.display = "none";
            autoFields.style.display = "block";
            if (autoResults) autoResults.style.display = "block";
            if (averageCost != null) averageCost.style.display = "none";
        }
    }

    function toggleDetails(element) {
        var details = element.nextElementSibling;
        if (details.style.display === "none" || details.style.display === "") {
            details.style.display = "block";
        } else {
            details.style.display = "none";
        }
    }

    function formatAndSavePricePerKm(input) {
        let expression = input.value.replace(",", ".");
        document.getElementById("PricePerKm").value = expression;
        localStorage.setItem("pricePerKm", expression);
    }

    function saveFuelType(input) {
        localStorage.setItem("selectedFuelType", input.value);
    }

    $(function () {
        let debounceTimer = null;
        const $input = $("#CarType");
        const $suggestionsBox = $("#suggestions");

        $input.on('input', function () {
            clearTimeout(debounceTimer);
            const searchTerm = $(this).val().trim();
            $suggestionsBox.empty().hide();

            debounceTimer = setTimeout(function () {
                if (searchTerm.length > 0) {
                    $.ajax({
                        url: '?handler=FilterCarTypes',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: searchTerm },
                        success: function (data) {
                            data.filteredCars.forEach(car => {
                                const item = $('<div class="suggestion-item"></div>').text(car);
                                $suggestionsBox.append(item);
                            });
                            if (data.filteredCars.length > 0) {
                                $suggestionsBox.show();
                            }
                        },
                        error: function () {
                            console.error("Fehler bei der Filterabfrage");
                        }
                    });
                }
            }, 300);
        });

        $suggestionsBox.on('click', '.suggestion-item', function () {
            const selectedCarType = $(this).text();
            $input.val(selectedCarType);
            $suggestionsBox.empty().hide();
            if (selectedCarType === "") {
                $('#PricePerKm').val('');
                return;
            }

            $.ajax({
                url: '?handler=PricePerKm',
                type: 'GET',
                data: { carType: selectedCarType },
                success: function (data) {
                    $('#PricePerKm').val(data.pricePerKm);
                    localStorage.setItem("pricePerKm", data.pricePerKm);
                },
                error: function () {
                    console.error("Fehler beim Abrufen von PricePerKm");
                }
            });
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#suggestions, #CarType').length) {
                $suggestionsBox.empty().hide();
            }
        });
    });

    $(function () {
        var type = '@TempData["ToastType"]';
        var message = '@TempData["ToastMessage"]';

        if (message) {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-bottom-right"
            };
            toastr[type](message);
        }
    });

    document.addEventListener('DOMContentLoaded', function () {

            // Tooltips (bereits vorhanden)
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));

            // Modus-Tabs
            document.querySelectorAll('.hidden-radio').forEach(radio => {
                radio.addEventListener('change', () => toggleInputMethod(radio));
            });

            // Spritart
            document.querySelectorAll('.fuel-radio').forEach(radio => {
                radio.addEventListener('change', () => saveFuelType(radio));
            });

            //Standort
            document.getElementById('generalLocationInput')?.addEventListener('blur', function () {
                this.value = this.value.trim();
                if(isPLZ(this.value)){
                    localStorage.setItem("generalLocation", this.value);
                }
                else{
                    localStorage.removeItem("generalLocation");
                }
            });

            //Standort 1 Vergleich
            document.getElementById('FirstComparePlace')?.addEventListener('blur', function () {
                this.value = this.value.trim();
                if(isPLZ(this.value)){
                    localStorage.setItem("FirstComparePlace", this.value);
                }
                else{
                    localStorage.removeItem("FirstComparePlace");
                }
            });
            //Radius Standort 1 Vergleich outputRadius0  RadiusPlace0Lbl
            document.getElementById('RadiusPlace0')?.addEventListener('change', function () {
                localStorage.setItem("FirstComparePlaceRadius", this.value.trim());
            });

            //Standort 2 Vergleich
            document.getElementById('SecondComparePlace')?.addEventListener('blur', function () {
                this.value = this.value.trim();
                if(isPLZ(this.value)){
                    localStorage.setItem("SecondComparePlace", this.value);
                }
                else{
                    localStorage.removeItem("SecondComparePlace");
                }
            });
            //Radius Standort 2 Vergleich outputRadius1  RadiusPlace1Lbl
            document.getElementById('RadiusPlace1')?.addEventListener('change', function () {
                localStorage.setItem("SecondComparePlaceRadius", this.value.trim());
            });

            // Tankmenge Slider
            document.getElementById('FuelAmountRange')
                ?.addEventListener('input', function () { updateFuel(this.value); });

            // Maximale Tankmenge
            document.getElementById('MaximumFuelAmount')
                ?.addEventListener('blur', function () { updateMax(this.value); });

            // Kosten pro km
            document.getElementById('PricePerKm')
                ?.addEventListener('blur', function () { formatAndSavePricePerKm(this); });

            // Radius Standort 1 & 2
            document.getElementById('RadiusPlace0')
                ?.addEventListener('input', function () {
                    document.getElementById('outputRadius0').textContent = this.value + ' km';
                });
            document.getElementById('RadiusPlace1')
                ?.addEventListener('input', function () {
                    document.getElementById('outputRadius1').textContent = this.value + ' km';
                });

            // Standort hinzufügen
            document.getElementById('addStandort')
                ?.addEventListener('click', addLocation);

            // Submit Loader Buttons
            document.getElementById('SearchBtn')
                ?.addEventListener('click', function () {
                    document.getElementById('loader-search').style.display = 'inline-block';
                });
            document.getElementById('loader-compare')?.closest('button')
                ?.addEventListener('click', function () {
                    document.getElementById('loader-compare').style.display = 'inline-block';
                });

            // View Dropdown
            document.getElementById('viewModeCustom')?.querySelector('.select-trigger')
                ?.addEventListener('click', toggleDropdown);

            document.querySelectorAll('#optionsList .suggestion-item').forEach(el => {
                el.addEventListener('click', () => selectOption(el));
            });

            // Sort Dropdown
            document.getElementById('sortModeCustom')?.querySelector('.select-trigger')
                ?.addEventListener('click', toggleDropdownSort);

            document.querySelectorAll('#sortOptionsList .suggestion-item').forEach(el => {
                el.addEventListener('click', () => selectOptionSort(el));
            });

            // Geo Buttons (bereits vorhanden)
            document.getElementById("geoButton")?.addEventListener("click", getLocation);
            document.getElementById("geoButton2")?.addEventListener("click", getLocation);

            // Radius Slider
            const slider = document.getElementById('generalRadius');
            const output = document.getElementById('radiusValue');
            if (slider && output) {
                output.textContent = slider.value + ' km';
                slider.addEventListener('input', () => {
                    output.textContent = slider.value + ' km';
                });
            }

            // localStorage wiederherstellen (bereits vorhanden)
            const savedPricePerKm = localStorage.getItem("pricePerKm");
            if (savedPricePerKm) $('#PricePerKm').val(savedPricePerKm);

            const savedFuelType = localStorage.getItem("selectedFuelType");
            if (savedFuelType) {
                const radio = document.querySelector(`input[name="SelectedFuelType"][value="${savedFuelType}"]`);
                if (radio) radio.checked = true;
            }

            const maxVolume = localStorage.getItem("maxVolume");
            if (maxVolume) {
                document.getElementById('MaximumFuelAmount').value = maxVolume;
                document.getElementById('FuelAmountRange').max = maxVolume;
            }

            const fuelRange = document.getElementById('FuelAmountRange');
            const fuelValue = @Model.FuelAmount;
            if (fuelRange) {
                fuelRange.value = fuelValue;
            }

            // In DOMContentLoaded hinzufügen:
            document.querySelectorAll('input[type="range"][data-output-id]').forEach(slider => {
                slider.addEventListener('input', function () {
                    const outputId = this.getAttribute('data-output-id');
                    const output = document.getElementById(outputId);
                    if (output) output.textContent = this.value + ' km';
                });
            });


            const stationContainer = document.getElementById('stationListContainer');
            if (stationContainer) {
                stationContainer.addEventListener('click', function(e) {
                    const summary = e.target.closest('.station-summary');
                    if (summary) toggleDetails(summary);
                });
            }

            const generalLocationInput = localStorage.getItem("generalLocation");
            if(generalLocationInput){
                const generalLocationField = document.getElementById("generalLocationInput");
                if(generalLocationField){
                    generalLocationField.value = generalLocationInput;
                }
            }

            const FirstComparePlaceInput = localStorage.getItem("FirstComparePlace");
            if(FirstComparePlaceInput){
                const firstComparePlace = document.getElementById("FirstComparePlace");
                if(firstComparePlace && firstComparePlace.value.trim() === ""){
                    firstComparePlace.value = FirstComparePlaceInput;
                }
            }

            const SecondComparePlaceInput = localStorage.getItem("SecondComparePlace");
            if(SecondComparePlaceInput){
                const secondComparePlace = document.getElementById("SecondComparePlace");
                if(secondComparePlace){
                    secondComparePlace.value = SecondComparePlaceInput;
                }
            }

            const FirstComparePlaceRadiusInput = localStorage.getItem("FirstComparePlaceRadius");
            if(FirstComparePlaceRadiusInput){
                const firstComparePlaceRadius = document.getElementById("RadiusPlace0");
                if(firstComparePlaceRadius){
                    firstComparePlaceRadius.value = FirstComparePlaceRadiusInput;
                }
                const firstComparePlaceRadiusLbl = document.getElementById("outputRadius0");
                if(firstComparePlaceRadiusLbl){
                    firstComparePlaceRadiusLbl.textContent = FirstComparePlaceRadiusInput + ' km';
                }
            }

            const SecondComparePlaceRadiusInput = localStorage.getItem("SecondComparePlaceRadius");
            if(SecondComparePlaceRadiusInput){
                const secondPlaceRadius = document.getElementById("RadiusPlace1");
                if(secondPlaceRadius){
                    secondPlaceRadius.value = SecondComparePlaceRadiusInput;
                }
                const secondComparePlaceRadiusLbl = document.getElementById("outputRadius1");
                if(secondComparePlaceRadiusLbl){
                    secondComparePlaceRadiusLbl.textContent = SecondComparePlaceRadiusInput + ' km';
                }
            }

            updateFuel("@Model.FuelAmount");
            
        });
    document.addEventListener('input', function (e) {
        if (e.target.matches('input[type="range"][data-output-id]')) {
            const outputId = e.target.getAttribute('data-output-id');
            const output = document.getElementById(outputId);
            if (output) output.textContent = e.target.value + ' km';
        }
    });

    function switchView(value) {
        const selected = value;
        document.getElementById("stationListContainer").style.display = selected === "list" ? "block" : "none";
        document.getElementById("mapView").style.display = selected === "map" ? "block" : "none";

        if (selected === "map") {
            if (!mapInitialized) {
                initMap();
                mapInitialized = true;
            }
            document.getElementById("mapTooltip").style.display = "inline-block";
            document.getElementById("sortLabel").style.display = "none";
            document.getElementById("sortModeCustom").style.display = "none";
        } else {
            document.getElementById("mapTooltip").style.display = "none";
            document.getElementById("sortLabel").style.display = "inline-block";
            document.getElementById("sortModeCustom").style.display = "inline-block";
            const listTooltip = document.getElementById("listTooltip");
            if (listTooltip) listTooltip.style.display = "inline-block";
        }
    }

    function initMap() {
        var latitude = @Model.LatitudePlace.ToString().Replace(",", ".");
        var longitude = @Model.LongitudePlace.ToString().Replace(",", ".");
        map = L.map('map_div').setView([latitude, longitude], 12);
        Tiles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap',
        });
        Tiles.addTo(map);
        const storedMode = localStorage.getItem("darkMode");
        const mapDiv = document.getElementById("map_div");
        if (storedMode === "dark" || (storedMode === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            mapDiv.classList.add("dark-map");
        } else {
            mapDiv.classList.remove("dark-map");
        }

        const defaultIcon = new L.Icon({
            iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
            shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            tooltipAnchor: [0, -32],
            shadowSize: [41, 41]
        });
        const greenIcon = new L.Icon({
            iconUrl: 'marker-icon-green.png',
            shadowUrl: 'lib/leaflet/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            tooltipAnchor: [0, -32],
            shadowSize: [41, 41]
        });

        @foreach (var station in Model.CheapestResultStations.Take(10))
        {
            var lat = station.Coords.Lat.ToString().Replace(",", ".");
            var lng = station.Coords.Lng.ToString().Replace(",", ".");
            var price = Model.FuelAmount > 0
                ? Model.ToDisplayFloatingPoint(station.TotalCombinedCosts.ToString())
                : Model.ToDisplayFloatingPoint(station.FuelTypePrice.ToString());

            var isCheapest = station == Model.CheapestResultStations.First();

            <text>
                L.marker([@lat, @lng], { icon: @(isCheapest ? "greenIcon" : "defaultIcon") })
                    .addTo(map)
                    .bindTooltip(`@price €`, { permanent: true, direction: "top" })
                    .openTooltip()
                    .on('click', function () {
                        window.open("https://www.google.com/maps?q=@lat,@lng", "_blank", "noopener,noreferrer");
                    });
            </text>
        }
    }

    function getLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(sendPositionToServer, handleError);
        } else {
            toastr.warning("Geolocation wird nicht unterstützt.");
        }
    }

    async function sendPositionToServer(position) {
        const lat = position.coords.latitude;
        const lon = position.coords.longitude;

        const response = await fetch("?handler=UpdateLocation", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ latitude: lat, longitude: lon })
        });

        if (response.ok) {
            const result = await response.json();
            if (result.success && result.address) {
                if (document.getElementById("generalLocationInput")) {
                    document.getElementById("generalLocationInput").value = result.address;
                    localStorage.removeItem("generalLocation")
                }
                if (document.getElementById("GeoStandort")) {
                    document.getElementById("GeoStandort").value = result.address;
                }
                if (document.getElementById("FirstComparePlace")) {
                    document.getElementById("FirstComparePlace").value = result.address;
                }
            }
        } else {
            toastr.error("Serverfehler bei Standortabfrage.");
        }
    }

    function handleError(error) {
        switch (error.code) {
            case error.PERMISSION_DENIED:
                toastr.warning("Nutzer hat die Standortfreigabe abgelehnt.");
                break;
            case error.POSITION_UNAVAILABLE:
                toastr.warning("Standortinformationen nicht verfügbar.");
                break;
            case error.TIMEOUT:
                toastr.warning("Standortabfrage hat zu lange gedauert.");
                break;
            default:
                toastr.warning("Unbekannter Fehler.");
        }
    }

    function addLocation() {
        const container = document.getElementById("dynamicLocations");
        if (locationIndex < 4) {
            const html = `
                <div class="location-row location-fade-in">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <label class="section-label mb-1">Standort ${locationIndex + 1}</label>
                            <input type="text"
                                name="NamePlaces[${locationIndex}]"
                                id="NamePlaces[${locationIndex}]"
                                class="form-control"
                                placeholder="Ort eingeben" />
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-1">
                                <label class="section-label mb-0">Radius</label>
                                <div class="flex-grow-1 text-center">
                                    <output id="outputRadius${locationIndex}" class="value-output">10 km</output>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted ms-1">1</small>
                                <div class="flex-grow-1">
                                    <input type="range"
                                        name="RadiusPlaces[${locationIndex}]"
                                        class="form-range custom-range"
                                        min="1" max="25" step="1"
                                        value="10"
                                        id="RadiusPlace${locationIndex}"
                                        data-output-id="outputRadius${locationIndex}">
                                </div>
                                <small class="text-muted ms-1">25</small>
                            </div>
                        </div>
                    </div>
                </div>`;

            container.insertAdjacentHTML("beforeend", html);
            locationIndex++;
        }

        if (locationIndex >= 4) {
            const button = document.getElementById("addStandort");
            button.disabled = true;
            button.classList.add("disabled");
            button.textContent = "Maximale Standorte erreicht";
        }
    }

    function sortList(sortValue) {
        const container = document.getElementById('stationListContainer');
        container.innerHTML = '<p>Sortiert...</p>';

        const validSortModes = ['fuelPrice', 'distance', 'totalCost'];
        if (!validSortModes.includes(sortValue)) {
            console.error('Ungültiger sortMode:', sortValue);
            container.innerHTML = '<p>Ungültiger Sortiermodus</p>';
            return;
        }

        const formData = new FormData();
        formData.append('sortMode', sortValue);

        fetch('?handler=Sort', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: formData
        })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(text => { throw new Error(`HTTP ${response.status}: ${text}`); });
                }
                return response.text();
            })
            .then(html => {
                container.innerHTML = html;
            })
            .catch(err => {
                console.error('Sortierfehler:', err);
                const p = document.createElement('p');
                p.textContent = 'Fehler: ' + err.message;
                container.replaceChildren(p);
            });
    }

    function toggleDropdown() {
        const optionsList = document.getElementById('optionsList');
        optionsList.style.display = optionsList.style.display === 'block' ? 'none' : 'block';
    }

    function selectOption(element) {
        const selectedValue = document.getElementById('selectedValue');
        selectedValue.textContent = element.textContent;
        const value = element.getAttribute('data-value');
        document.getElementById('optionsList').style.display = 'none';
        switchView(value);
    }

    function toggleDropdownSort() {
        const optionsList = document.getElementById('sortOptionsList');
        optionsList.style.display = optionsList.style.display === 'block' ? 'none' : 'block';
    }

    function selectOptionSort(element) {
        const selectedValue = document.getElementById('selectedSortValue');
        selectedValue.textContent = element.textContent;
        const value = element.getAttribute('data-value');
        document.getElementById('sortOptionsList').style.display = 'none';
        sortList(value);
    }

    function isPLZ(input){
        const plzRegex = /^\d{5}$/;
        return plzRegex.test(input);
    }

    document.addEventListener('click', function (event) {
        const viewSelect = document.getElementById('viewModeCustom');
        if (viewSelect && !viewSelect.contains(event.target)) {
            document.getElementById('optionsList').style.display = 'none';
        }

        const sortSelect = document.getElementById('sortModeCustom');
        if (sortSelect && !sortSelect.contains(event.target)) {
            document.getElementById('sortOptionsList').style.display = 'none';
        }
    });
</script>
