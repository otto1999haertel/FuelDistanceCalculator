            const FirstComparePlaceInput = localStorage.getItem("FirstComparePlace");
            if(FirstComparePlaceInput){
                const firstComparePlace = document.getElementById("FirstComparePlace");
                if(firstComparePlace && firstComparePlace.value.trim() === ""){
