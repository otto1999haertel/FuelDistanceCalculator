@page
@using FuelDistanceCalculator.Constants
@using System.Globalization
@using Microsoft.CodeAnalysis.CSharp.Syntax
@model IndexModel
@{
    ViewData["Title"] = "FuelGo";
    var culture = new CultureInfo("de-DE");
}

<!-- Google tag (gtag.js) -->
@if (Model.IsProduction)
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JEP2Q2QZMH"></script>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="..." crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="..." crossorigin=""></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-JEP2Q2QZMH');
</script>

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<div class="text-center">
    <h1 class="display-4">Willkommen bei FuelGo</h1>
    <p>Finde die optimale Tankstelle oder vergleiche die durchschnittlichen Spritkosten zwischen mehreren Orten</p>
</div>

<div class="container">
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="row justify-content-center">
            <div class="col-md-6">

                <!-- Spritart -->
                <div class="mb-3">
                    <label class="form-label">Spritart</label>
                    <div class="d-flex gap-3">
                        @foreach (var kvp in FuelTypeHelper.FuelTypeNames)
                        {
                            <div class="form-check">
                                <input class="styled-radio"
                                    type="radio"
                                    asp-for="SelectedFuelType"
                                    value="@kvp.Key"
                                    id="fuel_@kvp.Key" 
                                    onchange="saveFuelType(this)"/>
                                <label class="form-check-label" for="fuel_@kvp.Key">
                                    @kvp.Value
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tankstellenmarke & Rabatt -->
                <div class="mb-3">
                    <div class="row gx-3">
                        <div class="col-md-6">
                            <label for="stationBrand">Tankstellenmarke</label>
                            <input type="text" id="stationBrand" name="StationBrand" class="form-control"
                                placeholder="z.B. Shell, Aral" value="@Model.StationBrand" />
                        </div>
                        <div class="col-md-6">
                            <label for="discountPercent">Rabatt (%/€)</label>
                            <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                title="Verwende % für prozentuale Rabatte oder ohne Suffix für Festbeträge.">
                                ⓘ
                            </span>
                            <input type="text" id="discountPercent" name="DiscountPercentOrAbsolute" class="form-control"
                                    placeholder="z.B. 30% oder 20" min="0" value="@Model.DiscountPercentOrAbsolute" />
                        </div>
                    </div>
                </div>

                <!-- Tankmenge -->
                <div class="mb-3">
                    <label for="fuelAmount">
                        Vorrausichtliche Tankmenge (@Model.VolumeUnit)
                        <span style="bold" id="fuelAmountValue">@Model.FuelAmount</span>
                    </label>
                    <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                        title="Nutze das Textfeld für die Angabe der maximalen Tankmenge und den Slider für das Einstellen der aktuellen Tankmenge">
                        ⓘ
                    </span>
                    <div class="d-flex align-items-center gap-2">

                    <!-- Links: Min Label -->
                    <small class="text-muted">0</small>

                    <!-- Slider -->
                    <div class="flex-grow-1">
                        <input type="range"
                            name="FuelAmount"
                            class="form-range"
                            min="0"
                            max="25"
                            step="1"
                            value="@(Model.FuelAmount)"
                            id="FuelAmountRange"
                            oninput="updateFuel(this.value)">
                    </div>

                    <!-- Rechts: Input für Max -->
                    <input type="number"
                        id="MaximumFuelAmount"
                        class="form-control"
                        style="width: 80px;"
                        value="@Model.FuelAmount"
                        oninput="updateMax(this.value)">
                </div>
                </div>

                <!-- Fahrzeugtyp & Kosten pro KM -->
                <div class="mb-3">
                    <div class="row gx-3">
                        <div class="col-md-6">
                            <label for="SelectedCarType">Fahrzeugtyp </label>
                            <span>
                                <a href="https://www.adac.de/rund-ums-fahrzeug/auto-kaufen-verkaufen/autokosten/uebersicht/"
                                    target="_blank">
                                    (ADAC Vorschlag)</a><sup><a href="#fn1" id="ref1">1</a></sup>
                            </span>
                            <input type="text" class="form-control" id="CarType" placeholder="Fahrzeugtyp suchen..."
                                list="CarTypeList" value="@Model.SelectedCarType" asp-for="SelectedCarType">
                            <div id="suggestions" class="suggestions-box"></div>
                        </div>
                        <div class="col-md-6">
                            <label for="PricePerKm">Kosten pro Kilometer (€)</label>
                            <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                title="Durchschnittliche Kosten pro Kilometer, für Vorschläge nutze die Fahrzeugtypsuche">
                                ⓘ
                            </span>
                            <input type="number" class="form-control" id="PricePerKm" name="PricePerKm" required
                            asp-for="PricePerKm" value="@Model.PricePerKm" onblur="formatAndSavePricePerKm(this)"
                                step="any" min="0.01"/>
                        </div>
                    </div>
                </div>

                <!-- Modus -->
                <div class="mb-2">
                    <div class="d-flex gap-3">
                        @foreach (InputMode mode in Enum.GetValues(typeof(InputMode)))
                        {
                            var displayText = mode == InputMode.auto ? "Optimale Suche" : "Standortvergleich";
                            var radioId = $"mode_{mode}";

                            <div class="form-check">
                                <input class="styled-radio"
                                    type="radio"
                                    asp-for="SelectInputMode"
                                    value="@mode"
                                    id="@radioId"
                                    onchange="toggleInputMethod(this)" />
                                <label class="form-check-label" for="@radioId">
                                    @displayText
                                </label>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

        <!-- Vergleich-Modus -->
        <div id="manualInputFields" class="modeStyle" style="display:@(Model.SelectInputMode == InputMode.man ? "block" : "none")">
                
                @if ((bool)Model.NamePlaces?.Any() || string.IsNullOrWhiteSpace(Model.NamePlaces[0]))
                {
                    <div class="row g-3 align-items-start">

                        <!-- Standort 1 -->
                        <div class="col-md-5 offset-md-1">
                            <label class="form-label mb-0">Standort 1</label>

                            <!-- Input -->
                            <div class="input-group">
                                <input type="text"
                                    name="NamePlaces[0]"
                                    class="form-control"
                                    id="FirstComparePlace"
                                    value="@(Model.NamePlaces.Count > 0 ? Model.NamePlaces[0] : "")"
                                    placeholder="Geben Sie einen Ort ein" />

                                <button id="geoButton2" class="btn btn-primary btn-sm locationButton" type="button">
                                    <img src="location.png" alt="Standort">
                                </button>
                            </div>
                        </div>

                        <!-- Radius 1 -->
                        <div class="col-md-5">

                            <!-- Label + Output (gleich wie autoInputFields) -->
                            <div class="d-flex align-items-center mb-1">
                                <label for="RadiusPlace0"  class="form-label mb-0">Radius</label>

                                <div class="flex-grow-1 text-center">
                                    <output id="outputRadius0" class="value-output">
                                        @(Model.RadiusPlaces.Count > 0 ? Model.RadiusPlaces[0] : 10) km
                                    </output>
                                </div>
                            </div>

                            <!-- Slider -->
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <small class="text-muted ms-1">1 km</small>

                                <div class="flex-grow-1">
                                    <input type="range"
                                        name="RadiusPlaces[0]"
                                        class="form-range"
                                        min="1" max="25" step="1"
                                        value="@(Model.RadiusPlaces.Count > 0 ? Model.RadiusPlaces[0] : 10)"
