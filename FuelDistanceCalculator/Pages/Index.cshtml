            // Sort Dropdown
            document.getElementById('sortModeCustom')?.querySelector('.select-trigger')
                ?.addEventListener('click', toggleDropdownSort);

            document.querySelectorAll('#sortOptionsList .suggestion-item').forEach(el => {
                el.addEventListener('click', () => selectOptionSort(el));
            });

            // Geo Buttons (bereits vorhanden)
            document.getElementById("geoButton")?.addEventListener("click", getLocation);
            document.getElementById("geoButton2")?.addEventListener("click", getLocation);

            // Radius Slider
            const slider = document.getElementById('generalRadius');
            const output = document.getElementById('radiusValue');
