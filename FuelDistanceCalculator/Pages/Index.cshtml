@page
@using FuelDistanceCalculator.Constants
@using System.Globalization
@using Microsoft.CodeAnalysis.CSharp.Syntax
@model IndexModel
@{
    ViewData["Title"] = "FuelGo";
    var culture = new CultureInfo("de-DE");
}

<!-- Google tag (gtag.js) -->
@if (Model.IsProduction)
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JEP2Q2QZMH"></script>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="..." crossorigin="" />
<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="..." crossorigin=""></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-JEP2Q2QZMH');
</script>


<meta name="viewport" content="width=device-width, initial-scale=1.0">
<div class="text-center">
    <h1 class="display-4">Willkommen bei FuelGo</h1>
    <p>Finde die optimale Tankstelle oder vergleiche die durchschnittlichen Spritkosten zwischen mehreren Orten</p>
</div>

<div class="container">
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="row justify-content-center">
            <!-- Eingabefelder für globale Werte - mittig zentriert -->
            <div class="col-md-6">
                <!-- Radio buttons für Spritart -->
                <div class="mb-3">
                <label class="form-label">Spritart</label>
                <div class="d-flex gap-4">
                    @foreach (var kvp in FuelTypeHelper.FuelTypeNames)
                    {
                        <div class="form-check">
                            <input class="styled-radio" 
                                type="radio" 
                                asp-for="SelectedFuelType" 
                                value="@kvp.Key" 
                                id="fuel_@kvp.Key" />
                            <label class="form-check-label" for="fuel_@kvp.Key">
                                @kvp.Value
                            </label>
                        </div>
                    }
                </div>
            </div>

                <div class="form-group">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label for="stationBrand">Tankstellenmarke</label>
                            <input type="text" id="stationBrand" name="StationBrand" class="form-control" 
                                placeholder="z.B. Shell, Aral" value="@Model.StationBrand" />
                        </div>
                        <div class="col-md-6">
                            <label for="discountPercent">Rabatt (%/€)</label>
                            <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                title="Verwende % für prozentuale Rabatte oder ohne Suffix für Festbeträge.">
                                ⓘ
                            </span>
                            <input type="text" id="discountPercent" name="DiscountPercentOrAbsolute" class="form-control" 
                                    placeholder="z.B. 30% oder 20" min="0" value="@Model.DiscountPercentOrAbsolute" />
                        </div>
                    </div>
                </div>

                <!-- Eingabe für Tankmenge -->
                <div class="form-group">
                    <label for="fuelAmount">Vorrausichtliche Tankmenge (@Model.VolumeUnit)</label>
                    <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                        title="Du kannst auch Berechnungen mit +, −, *, / durchführen. Falls du 0 eingibst wird die Liste nach Spritpreisen sortiert">
                        ⓘ
                    </span>
                    <input type="text" id="FuelAmountDisplay" class="form-control" required
                        onblur="calculateAndStore(this)" value="@Model.FuelAmount" />
                    <input type="hidden" id="FuelAmount" name="FuelAmount" value="@Model.FuelAmount" />

                    <script>
                    </script>

                </div>

                <!-- Preis pro Kilometer -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="SelectedCarType">Fahrzeugtyp </label>
                            <span>
                                <a href="https://www.adac.de/rund-ums-fahrzeug/auto-kaufen-verkaufen/autokosten/uebersicht/"
                                    target="_blank">
                                    (ADAC Vorschlag)</a><sup><a href="#fn1" id="ref1">1</a></sup>
                            </span>
                            <input type="text" class="form-control" id="CarType" placeholder="Fahrzeugtyp suchen..."
                                list="CarTypeList" value="@Model.SelectedCarType" asp-for="SelectedCarType">
                            <div id="suggestions" class="suggestions-box"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <!-- Preis pro Kilometer -->
                        <div class="form-group">
                            <label for="PricePerKm">Kosten pro Kilometer (€)</label>
                            <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                title="Durchschnittliche Kosten pro Kilometer, für Vorschläge nutze die Fahrzeugtypsuche">
                                ⓘ
                            </span>
                            <input type="number" class="form-control" id="PricePerKm" name="PricePerKm" required 
                            asp-for="PricePerKm" value="@Model.PricePerKm" onblur="formatAndSavePricePerKm(this)"
                                step="any" min="0.01"/>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Modus</label>
                    <div class="d-flex gap-4">
                        @foreach (InputMode mode in Enum.GetValues(typeof(InputMode)))
                        {
                            var displayText = mode == InputMode.auto ? "Optimale Suche" : "Standortvergleich";
                            var radioId = $"mode_{mode}";

                            <div class="form-check">
                                <input class="styled-radio"
                                    type="radio"
                                    asp-for="SelectInputMode"
                                    value="@mode"
                                    id="@radioId"
                                    onchange="toggleInputMethod(this)" />
                                <label class="form-check-label" for="@radioId">
                                    @displayText
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- Manuelle Eingabe (wird ausgeblendet, wenn Automatische Auswahl gewählt wird) -->
        <div id="manualInputFields" class="modeStyle" style="display:@(Model.SelectInputMode == InputMode.man ? "block" : "none")">
             <div class="row g-3 align-items-start">
                @if ((bool)Model.NamePlaces?.Any() || string.IsNullOrWhiteSpace(Model.NamePlaces[0]))
                {
                    <!-- Standort 1 -->
                    <div class="col-md-5 offset-md-1">
                        <div class="d-flex flex-column h-100">
                                <label class="form-label mb-1">Standort 1</label>
                                <div class="input-group">
                                    <input type="text" name="NamePlaces[0]" id="FirstComparePlace" class="form-control"
                                        value="@(Model.NamePlaces.Count > 0 ? Model.NamePlaces[0] : "")"
                                        placeholder="Geben Sie einen Ort ein" />
                                    <button id="geoButton2" class="btn btn-primary btn-sm d-flex align-items-center justify-content-center locationButton" type="button">
                                        <img src="location.png" alt="Standort">
                                    </button>
                                </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                            <div class="d-flex flex-column h-100">
                                <label for="RadiusPlace1" class="form-label mb-1">Radius</label>
                                <div class="d-flex align-items-center gap-2 h-100">
                                    <label class="text-nowrap">1</label>
                                    <div class="slider-container flex-grow-1 d-flex align-items-center">
                                        <input type="range"
                                            name="RadiusPlaces[0]"
                                            class="form-range"
                                            min="1"
                                            max="25"
                                            step="1"
                                            value="@(Model.RadiusPlaces.Count > 0 ? Model.RadiusPlaces[0] : 10)"
                                            id="RadiusPlace0"
                                            oninput="document.getElementById('outputRadius0').textContent = this.value" />
                                    </div>
                                    <output id="outputRadius0" class="value-output">
                                        @(Model.RadiusPlaces.Count > 0 ? Model.RadiusPlaces[0] : 10)
                                    </output>
                                     <label class="text-nowrap">km</label>
                                </div>
                            </div>
                    </div>

                        <!-- Standort 2 -->
                        <div class="col-md-5 offset-md-1 mt-3">
                            <div class="d-flex flex-column h-100">
                                <label class="form-label mb-1">Standort 2</label>
                                <input type="text" 
                                    name="NamePlaces[1]" 
                                    class="form-control"
                                    value="@(Model.NamePlaces.Count > 1 ? Model.NamePlaces[1] : "")"
                                    placeholder="Geben Sie einen Ort ein" />
                            </div>
                        </div>

                        <!-- Radius für Standort 2 -->
                        <div class="col-md-5 mt-3">
                            <div class="d-flex flex-column h-100">
                                <label for="RadiusPlace2" class="form-label mb-1">Radius</label>
                                <div class="d-flex align-items-center gap-2 h-100">
                                    <label class="text-nowrap">1</label>
                                    
                                    <div class="slider-container flex-grow-1 d-flex align-items-center">
                                        <input type="range"
                                            name="RadiusPlaces[1]"
                                            class="form-range custom-range"
                                            min="1"
                                            max="25"
                                            step="1"
                                            value="@(Model.RadiusPlaces.Count > 1 ? Model.RadiusPlaces[1] : 10)"
                                            id="RadiusPlace1"
                                            oninput="document.getElementById('outputRadius1').textContent = this.value" />
                                    </div>
                                    
                                    <output id="outputRadius1" class="value-output text-center">
                                        @(Model.RadiusPlaces.Count > 1 ? Model.RadiusPlaces[1] : 10)
                                    </output>
                                    
                                    <label class="text-nowrap">km</label>
                                </div>
                            </div>
                        </div>
                }
                @if (Model.NamePlaces.Count > 2)
                {
                    @for (int i = 2; i < Model.NamePlaces.Count; i++)
                    {
                        <div class="col-md-5 offset-md-1 mt-3">
                                <div class="d-flex flex-column h-100">
                                    <label class="form-label mb-1">Standort @(i + 1)</label>
                                    <input type="text" name="NamePlaces[@i]" class="form-control" value="@Model.NamePlaces[i]"
                                        placeholder="Geben Sie einen Ort ein" />
                                </div>
                        </div>
                        <div class="col-md-5 mt-3">
                            <div class="d-flex flex-column  h-100">
                                <label for="RadiusPlace2" class="form-label mb-1">Radius</label>
                                <div class="d-flex align-items-center gap-2 h-100">
                                    <label class="text-nowrap">1</label>
                                    <div class="slider-container flex-grow-1 d-flex align-items-center">
                                        <input type="range"
                                            name="RadiusPlaces[@i]"
                                            class="form-range custom-range"
                                            min="1"
                                            max="25"
                                            step="1"
                                            value="@(Model.RadiusPlaces.Count > 1 ? Model.RadiusPlaces[i] : 10)"
                                            id="RadiusPlace@(i)"
                                            oninput="document.getElementById('outputRadius[@i]').textContent = this.value" />
                                    </div>
                                    <output  id="outputRadius[@i]" class="value-output text-center">
                                        @(Model.RadiusPlaces.Count > 0 ? Model.RadiusPlaces[i] : 10)
                                    </output>
                                    <label class="text-nowrap">km</label>
                                </div>
                        </div>
                    </div>
                    }
                }
            </div>

            <!-- Hier kommen zusätzliche Standorte hin -->
            <div id="dynamicLocations" class="row mt-3">
            </div>
            <!-- Plus-Button -->
            <div class="row justify-content-center mt-3">
                <button type="button" id="addStandort" class="btn btn-primary mx-2" style="width: 200px"
                    onclick="addLocation()" @(Model.NamePlaces.Count >= 4 ? "disabled" : "")>
                    @(Model.NamePlaces.Count >= 4 ? "Maximale Standorte erreicht" : "Standort hinzufügen")
                </button>
            </div>

            <!-- Berechnen-Button -->
            <div class="row justify-content-center mt-3">
                <button type="submit" class="btn btn-primary mx-2" style="width: 120px"
                    asp-page-handler="CalculateAverageCost">Vergleichen
                </button>
            </div>
        </div>

        <!-- Automatische Auswahl (wird angezeigt, wenn Automatische Auswahl gewählt wird) -->
        <div id="autoInputFields" class="modeStyle" style="display:@(Model.SelectInputMode == InputMode.auto ? "block" : "none")">
            <!-- Automatische Eingabe für Standort und Radius -->
           <div class="row g-3 align-items-start">
                    <div class="col-md-5 offset-md-1">
                        <div class="d-flex flex-column h-100">
                            <label for="generalLocation" class="form-label mb-1">Standort (PLZ/ Straße, Ort)</label>
                            <div class="input-group">
                                <input type="text" id="generalLocation" class="form-control"
                                    placeholder="Geben Sie einen Ort ein" asp-for="Place" value="@Model.Place">
                                <button id="geoButton" class="btn btn-primary btn-sm d-flex align-items-center justify-content-center locationButton" type="button">
                                    <img src="location.png" alt="Standort">
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="d-flex flex-column h-100">
                            <label for="generalRadius" class="form-label mb-1">Radius</label>
                            <div class="d-flex align-items-center gap-2 h-100">
                                <label class="text-nowrap">1</label>
                                <div class="slider-container flex-grow-1 d-flex align-items-center">
                                    <input type="range"
                                        id="generalRadius"
                                        class="form-range custom-range"
                                        min="1" max="25" step="1"
                                        asp-for="Radius" />
                                </div>
                                <output id="radiusValue" class="value-output">
                                    @(Model.Radius)
                                </output>
                                <label class="text-nowrap">km</label>
                            </div>
                            <input type="number" asp-for="Radius" class="d-none" min="1" max="25" />
                        </div>
                    </div>
                </div>
            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-primary mx-2" style="width: 120px"
                    asp-page-handler="Search" id="SearchBtn">Suchen</button>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-6" style="padding: 20px;">
                @if (Model.CheapestResultStations.Any())
                {
                        <div class="mb-3 d-flex align-items-center gap-2">
                            <label for="viewMode" class="form-label mb-0 me-2">Ansicht</label>
                            <div id="viewModeCustom" class="custom-select">
                                <div class="select-trigger" onclick="toggleDropdown()">
                                    <span id="selectedValue">Liste</span> <!-- Standardwert -->
                                    <span class="arrow">▼</span> <!-- Custom Pfeil -->
                                </div>
                                <div id="optionsList" class="suggestions-box"> <!-- Wiederverwende deine CSS-Klasse! -->
                                    <div class="suggestion-item" data-value="list" onclick="selectOption(this)">Liste</div>
                                    <div class="suggestion-item" data-value="map" onclick="selectOption(this)">Karte</div>
                                </div>
                                </div>
                            @if (Model.FuelAmount > 0)
                            {
                                <span id="listTooltip" class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                     title="Die Wegkosten werden für Hin- und Rückfahrt angesetzte">
                                    ⓘ
                                </span>
                            }

                            <span id="mapTooltip" class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                title="Für Routenplanung via Google Maps klicke auf die Markierung der Tankstelle" style="display: none;">
                                ⓘ
                            </span>

                            <!-- Neues Dropdown für Sortierung (nur in Listenansicht sichtbar) -->
                            <label for="sortMode" class="form-label mb-0 me-2" id="sortLabel">Aufsteigend sortieren nach</label>
                                <div id="sortModeCustom" class="custom-select">
                                    <div class="select-trigger" onclick="toggleDropdownSort()">
                                        <span id="selectedSortValue">
                                            @if (Model.FuelAmount > 0)
                                            {
                                                <text>Gesamtkosten</text> <!-- Standardwert: Erste Option -->
                                            }
                                            else
                                            {
                                                <text>Preis pro Liter</text> <!-- Standardwert: Erste Option -->
                                            }
                                        </span>
                                        <span class="arrow">▼</span> <!-- Custom Pfeil, wie zuvor -->
                                    </div>
                                    <div id="sortOptionsList" class="suggestions-box"> <!-- Wiederverwende deine CSS-Klasse! -->
                                        @if (Model.FuelAmount > 0)
                                        {
                                            <div class="suggestion-item" data-value="totalCost" onclick="selectOptionSort(this)">Gesamtkosten</div>
                                            <div class="suggestion-item" data-value="fuelPrice" onclick="selectOptionSort(this)">Preis pro Liter</div>
                                            <div class="suggestion-item" data-value="distance" onclick="selectOptionSort(this)">Entfernung</div>
                                        }
                                        else
                                        {
                                            <div class="suggestion-item" data-value="fuelPrice" onclick="selectOptionSort(this)">Preis pro Liter</div>
                                            <div class="suggestion-item" data-value="distance" onclick="selectOptionSort(this)">Entfernung</div>
                                        }
                                    </div>
                                </div>
                        </div>
                        <div id="stationListContainer">
                            @await Html.PartialAsync("_StationListPartial", Model) @* Oder "~/Pages/Shared/_StationListPartial.cshtml" *@
                            @{ TempData.Keep("StationsJson"); TempData.Keep("FuelAmount"); }
                        </div>
                        <div id="mapView" style="display: none;">
                                    @* TODO add Tool tip with click option*@
                                    <div id="map_div" class="map" style="height: 500px;" />
                        </div>
                }
                else if(@Model.SearchExecuted){
                    <label id="noOpenStations" style="display: block; text-align: center;">
                        Keine offene Tankstelle im gewählten Radius gefunden
                    </label>
                }
                                 </div>
                    </div>
    </div>
    </form>
    </div>
    <!-- JavaScript für die Eingabe-Auswahl-Steuerung -->
    <script>
        let mapInitialized = false;
        let map;
        let Tiles;
        let locationIndex = @Model.NamePlaces.Count;

        const slider = document.getElementById('generalRadius');
            const output = document.getElementById('radiusValue');

            // Initialwert setzen
            output.textContent = slider.value ;

            // Bei Änderung aktualisieren
            slider.addEventListener('input', () => {
                output.textContent = slider.value;
            });

        function updateRadius(input) {
            // Wenn der Benutzer das Feld verlässt und nichts eingegeben hat, verwende den Platzhalter als Standard
            if (!input.value.trim()) {
                input.value = input.placeholder;  // Falls leer, setze den Platzhalterwert
            }

            // Aktualisiere das Modell im Hintergrund
            var radiusPlace1 = document.querySelector('input[name="RadiusPlace1"]');
            var radiusPlace2 = document.querySelector('input[name="RadiusPlace2"]');
            if (input.value > 0) {
                radiusPlace1.value = input.value;
                radiusPlace2.value = input.value;  // Das Modell im Hintergrund aktualisieren
            }
        }

        function calculateAndStore(input) {
            try {
                let expression = input.value.replace(",", "."); // Ersetze Komma durch Punkt
                input.value=0;
                document.getElementById("FuelAmount").value =0;
                if (/^[0-9+\-*/().\s]*$/.test(expression)) {
                    let result = eval(expression); // Berechne den Ausdruck
                    if (!isNaN(result) && result>=0) {
                        input.value = result; // Zeige das Ergebnis im Eingabefeld an
                        document.getElementById("FuelAmount").value = result; // Speichere das Ergebnis im versteckten Feld für das Model
                    }
                }
            } catch (e) {
                console.error("Ungültiger Ausdruck:", e);
            }
        }

        function toggleInputMethod(radio) {
            var manualFields = document.getElementById("manualInputFields");
            var autoFields = document.getElementById("autoInputFields");
            var averageCost = document.getElementById("averageCost");
            if (radio.value === "man") {
                manualFields.style.display = "block";
                autoFields.style.display = "none";
                if (averageCost != null) {
                    averageCost.style.display = "block";
                }
            }
            if (radio.value === "auto") {
                manualFields.style.display = "none";
                autoFields.style.display = "block";
                if (averageCost != null) {
                    averageCost.style.display = "none";
                }
            }
        }

        function toggleDetails(element) {
            // Holen des Elements, das die Details enthält
            var details = element.nextElementSibling;

            // Wenn die Details sichtbar sind, verstecke sie, sonst zeige sie an
            if (details.style.display === "none" || details.style.display === "") {
                details.style.display = "block";
            } else {
                details.style.display = "none";
            }
        }

        function formatAndSavePricePerKm(input) {
            let expression = input.value.replace(",", ".");
            document.getElementById("PricePerKm").value = expression;
            localStorage.setItem("pricePerKm", expression);
        }

        $(function () {
            let debounceTimer = null;
            const $input = $("#CarType");
            const $suggestionsBox = $("#suggestions");

            // Input-Feld beobachten
            $input.on('input', function () {
                clearTimeout(debounceTimer);
                const searchTerm = $(this).val().trim();
                $suggestionsBox.empty().hide();

                debounceTimer = setTimeout(function () {
                    if (searchTerm.length > 0) {
                        $.ajax({
                            url: '?handler=FilterCarTypes',
                            type: 'GET',
                            dataType: 'json',
                            data: { query: searchTerm },
                            success: function (data) {
                                data.filteredCars.forEach(car => {
                                    const item = $('<div class="suggestion-item"></div>').text(car);
                                    $suggestionsBox.append(item);
                                });
                                if (data.filteredCars.length > 0) {
                                    $suggestionsBox.show();
                                }
                            },
                            error: function () {
                                console.error("Fehler bei der Filterabfrage");
                            }
                        });
                    }
                }, 300); // <-- Debounce von 300 ms
            });

            // Nur EIN zentraler Click-Handler für dynamische Vorschläge
            $suggestionsBox.on('click', '.suggestion-item', function () {
                const selectedCarType = $(this).text();
                $input.val(selectedCarType);
                $suggestionsBox.empty().hide();
                if (selectedCarType === "") {
                    $('#PricePerKm').val('');
                    return;
                }

                $.ajax({
                    url: '?handler=PricePerKm',
                    type: 'GET',
                    data: { carType: selectedCarType },
                    success: function (data) {
                        $('#PricePerKm').val(data.pricePerKm);
                        localStorage.setItem("pricePerKm", data.pricePerKm);
                    },
                    error: function () {
                        console.error("Fehler beim Abrufen von PricePerKm");
                    }
                });
            });

            // Click außerhalb der Box: Suggestions schließen
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#suggestions, #CarType').length) {
                    $suggestionsBox.empty().hide();
                }
            });
        });

        $(function () {
            var type = '@TempData["ToastType"]';
            var message = '@TempData["ToastMessage"]';

            if (message) {
                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: "toast-bottom-right" // ⬅️ hier wird die Position gesetzt
                };
                toastr[type](message);
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl)
            });
            const savedPricePerKm = localStorage.getItem("pricePerKm");
            if (savedPricePerKm) {
                // Nur überschreiben wenn Server keinen Wert geliefert hat
                const currentValue = $('#PricePerKm').val();
                $('#PricePerKm').val(savedPricePerKm);
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            const geoButton = document.getElementById("geoButton");
            if (geoButton) {
                geoButton.addEventListener("click", getLocation);
            }

            const geoButton2 = document.getElementById("geoButton2");
            if (geoButton2) {
                geoButton2.addEventListener("click", getLocation);
            }
        });

        function switchView(value) {
            const selected = value;
            document.getElementById("stationListContainer").style.display = selected === "list" ? "block" : "none";
            document.getElementById("mapView").style.display = selected === "map" ? "block" : "none";

            if (selected === "map") {
                if (!mapInitialized) {
                    initMap();
                    mapInitialized = true;
                }
                document.getElementById("mapTooltip").style.display = "inline-block";
                document.getElementById("sortLabel").style.display = "none";
                document.getElementById("sortModeCustom").style.display = "none";
            }
            else {
                document.getElementById("mapTooltip").style.display = "none";
                document.getElementById("sortLabel").style.display = "inline-block";
                document.getElementById("sortModeCustom").style.display = "inline-block";
                document.getElementById("listTooltip").style.display = "inline-block";
            }
        }

        function initMap() {
            var latitude = @Model.LatitudePlace.ToString().Replace(",", ".");
            var longitude = @Model.LongitudePlace.ToString().Replace(",", ".");
            map = L.map('map_div').setView([latitude, longitude], 12); // Zentrum (z. B. Erlangen)
            Tiles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap',
            });
            Tiles.addTo(map);
            const storedMode = localStorage.getItem("darkMode");
            const mapDiv = document.getElementById("map_div");
            if (storedMode === "dark" || (storedMode === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                mapDiv.classList.add("dark-map");
            } else {
                mapDiv.classList.remove("dark-map");
            }

            const defaultIcon = new L.Icon({
                iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
                shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                tooltipAnchor: [0, -32],
                shadowSize: [41, 41]
            });
            // Beispiel-Marker (dynamisch aus Razor erzeugt)
            const greenIcon = new L.Icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
                shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],      // Spitze des Icons (für Popup/Tooltip Position)
                tooltipAnchor: [0, -32],   // <<–– das ist entscheidend!
                shadowSize: [41, 41]
            });

                    @foreach (var station in Model.CheapestResultStations)
                {
                    var lat = station.Coords.Lat.ToString().Replace(",", ".");
                    var lng = station.Coords.Lng.ToString().Replace(",", ".");
                    var name = Html.Raw(Json.Serialize(station.Name));
                    var price = Model.FuelAmount > 0
                    ? Model.ToDisplay(station.TotalCalculatedCoast.ToString())
                    : Model.ToDisplay(station.FuelTypePrice.ToString());

                    var isCheapest = station == Model.CheapestResultStations.First();

                    <text>
                        L.marker([@lat, @lng], {icon: @(isCheapest ? "greenIcon" : "defaultIcon") })
                        .addTo(map)
                        .bindTooltip(`@price €`, {permanent: true, direction: "top" })
                        .openTooltip()
                        .on('click',function(){
                            window.open("https://www.google.com/maps?q=@lat,@lng", "_blank");
                                                            });

                    </text>
            }
                }

        function getLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(sendPositionToServer, handleError);
            } else {
                alert("Geolocation wird nicht unterstützt.");
            }
        }

        async function sendPositionToServer(position) {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;

            const response = await fetch("?handler=UpdateLocation", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ latitude: lat, longitude: lon })
            });

            if (response.ok) {
                const result = await response.json();
                if (result.success && result.address) {
                    if (document.getElementById("generalLocation")) {
                        document.getElementById("generalLocation").value = result.address;
                    }
                    if (document.getElementById("GeoStandort")) {
                        document.getElementById("GeoStandort").value = result.address;
                    }
                    if (document.getElementById("FirstComparePlace")) {
                        document.getElementById("FirstComparePlace").value = result.address;
                    }
                }
            } else {
                alert("Serverfehler bei Standortabfrage.");
            }
        }

        function handleError(error) {
            switch (error.code) {
                case error.PERMISSION_DENIED:
                    alert("Nutzer hat die Standortfreigabe abgelehnt.");
                    break;
                case error.POSITION_UNAVAILABLE:
                    alert("Standortinformationen nicht verfügbar.");
                    break;
                case error.TIMEOUT:
                    alert("Standortabfrage hat zu lange gedauert.");
                    break;
                default:
                    alert("Unbekannter Fehler.");
            }
        }

        function addLocation() {
            const container = document.getElementById("dynamicLocations");
            if (locationIndex < 4) {
                const html = `
                    <div class="col-md-5 offset-md-1 mt-3 location-fade-in">
                        <div class="d-flex flex-column h-100">
                            <label class="form-label mb-1">Standort ${locationIndex + 1}</label>
                            <input type="text" 
                                name="NamePlaces[${locationIndex}]" 
                                class="form-control" 
                                placeholder="Geben Sie einen Ort ein" />
                        </div>
                    </div>
                    <div class="col-md-5 mt-3 location-fade-in">
                        <div class="d-flex flex-column">
                            <label class="form-label mb-1">Radius</label>
                            <div class="d-flex align-items-center gap-2 h-100">
                                <label class="text-nowrap">1</label>
                                <div class="slider-container flex-grow-1">
                                    <input type="range"
                                        name="RadiusPlaces[${locationIndex}]"
                                        class="form-range custom-range"
                                        min="1"
                                        max="25"
                                        step="1"
                                        value="10"
                                        id="RadiusPlace${locationIndex}"
                                        oninput="document.getElementById('outputRadius${locationIndex}').textContent = this.value" />
                                </div>
                                <output id="outputRadius${locationIndex}" class="value-output text-center">
                                    10
                                </output>
                                <label class="text-nowrap">km</label>
                            </div>
                        </div>
                    </div>`;
                
                container.insertAdjacentHTML("beforeend", html);
                locationIndex++;
            }

            if (locationIndex >= 4) {
                const button = document.getElementById("addStandort");
                button.disabled = true;
                button.classList.add("disabled");
                button.textContent = "Maximale Standorte erreicht";
            }
        }

        function sortList(sortValue) {
            console.log('Client: SortValue gesendet:', sortValue);
            const container = document.getElementById('stationListContainer');
            container.innerHTML = '<p>Sortiert...</p>';

            const validSortModes = ['fuelPrice', 'distance', 'totalCost'];
            if (!validSortModes.includes(sortValue)) {
                console.error('Ungültiger sortMode:', sortValue);
                container.innerHTML = '<p>Ungültiger Sortiermodus</p>';
                return;
            }

            const formData = new FormData();
            formData.append('sortMode', sortValue);

            fetch('?handler=Sort', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: formData
            })
            .then(response => {
                console.log('Response:', response);
                if (!response.ok) {
                    return response.text().then(text => { throw new Error(`HTTP ${response.status}: ${text}`); });
                }
                return response.text();
            })
            .then(html => {
                console.log('HTML empfangen:', html);
                container.innerHTML = html;
                document.querySelectorAll('.station-summary').forEach(el => el.onclick = () => toggleDetails(el));
            })
            .catch(err => {
                console.error('Fehler:', err);
                container.innerHTML = '<p>Fehler: ' + err.message + '</p>';
            });
        }

        function toggleDropdown() {
            const optionsList = document.getElementById('optionsList');
            optionsList.style.display = optionsList.style.display === 'block' ? 'none' : 'block';
            }

        function selectOption(element) {
            const selectedValue = document.getElementById('selectedValue');
            selectedValue.textContent = element.textContent;
            const value = element.getAttribute('data-value');
            
            // Schließe das Dropdown
            document.getElementById('optionsList').style.display = 'none';
            
            // Rufe deine Original-Funktion auf (z. B. switchView() mit dem Wert)
            switchView(value); // Passe switchView() an, um den Wert als Parameter zu akzeptieren, falls nötig
            }

        // Optional: Schließe das Dropdown bei Klick außerhalb
        document.addEventListener('click', function(event) {
            const customSelect = document.getElementById('viewModeCustom');
            if (!customSelect.contains(event.target)) {
                document.getElementById('optionsList').style.display = 'none';
            }
            });

        function toggleDropdownSort() {
            const optionsList = document.getElementById('sortOptionsList');
            optionsList.style.display = optionsList.style.display === 'block' ? 'none' : 'block';
        }

        function selectOptionSort(element) {
            const selectedValue = document.getElementById('selectedSortValue');
            selectedValue.textContent = element.textContent;
            const value = element.getAttribute('data-value');
            
            // Schließe das Dropdown
            document.getElementById('sortOptionsList').style.display = 'none';
            
            // Rufe die Original-Sortierfunktion auf (unverändert)
            sortList(value);
        }

        // Optional: Schließe das Dropdown bei Klick außerhalb
        document.addEventListener('click', function(event) {
            const customSelect = document.getElementById('sortModeCustom');
            if (!customSelect.contains(event.target)) {
                document.getElementById('sortOptionsList').style.display = 'none';
            }
        });

    </script>
