@page
@using FuelDistanceCalculator.Constants
@using System.Globalization
@using Microsoft.CodeAnalysis.CSharp.Syntax
@model IndexModel
@{
    ViewData["Title"] = "FuelGo";
    var culture = new CultureInfo("de-DE");

    // Erweiterte Einstellungen aufgeklappt lassen, falls Werte drin sind
    var advancedHasValue =
        !string.IsNullOrWhiteSpace(Model.StationBrand)
        || !string.IsNullOrWhiteSpace(Model.DiscountPercentOrAbsolute)
        || !string.IsNullOrWhiteSpace(Model.SelectedCarType);
}

<!-- Google tag (gtag.js) -->
@if (Model.IsProduction)
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JEP2Q2QZMH"></script>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="..." crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="..." crossorigin=""></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-JEP2Q2QZMH');
</script>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- HERO -->
<div class="hero-section text-center">
    <h1 class="display-5">Willkommen bei FuelGo</h1>
    <p class="lead">Finde die optimale Tankstelle oder vergleiche Spritpreise zwischen Orten</p>
</div>

<div class="container">
    <form method="post">
        @Html.AntiForgeryToken()

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">

                <!-- HAUPT-EINGABE-CARD -->
                <div class="card main-card mb-4">
                    <div class="card-body p-4">

                        <!-- MODUS-TABS -->
                        <ul class="mode-tabs" role="tablist">
                            @foreach (InputMode mode in Enum.GetValues(typeof(InputMode)))
                            {
                                var displayText = mode == InputMode.auto ? "Optimale Suche" : "Standortvergleich";
                                var radioId = $"mode_{mode}";
                                var isActive = Model.SelectInputMode == mode ? "active" : "";

                                <li class="nav-item">
                                    <input type="radio"
                                           class="hidden-radio"
                                           asp-for="SelectInputMode"
                                           value="@mode"
                                           id="@radioId"/>
                                    <label class="mode-tab @isActive" for="@radioId">
                                        @displayText
                                    </label>
                                </li>
                            }
                        </ul>

                        <!-- SPRITART -->
                        <div class="mb-4">
                            <label class="section-label">Spritart</label>
                            <div class="fuel-type-buttons">
                                @foreach (var kvp in FuelTypeHelper.FuelTypeNames)
                                {
                                    <input type="radio" class="fuel-radio"
                                           asp-for="SelectedFuelType"
                                           value="@kvp.Key"
                                           id="fuel_@kvp.Key"/>
                                    <label class="fuel-label" for="fuel_@kvp.Key">@kvp.Value</label>
                                }
                            </div>
                        </div>

                        <!-- ERWEITERTE EINSTELLUNGEN (für beide Modi) -->
                        <div class="mb-3">
                            <button class="advanced-toggle" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#advancedOptions"
                                    aria-expanded="@(advancedHasValue ? "true" : "false")"
                                    aria-controls="advancedOptions"
                                    id="advancedToggleButton">
                                <span>Erweiterte Einstellungen</span>
                                <span class="arrow-indicator">▼</span>
                            </button>

                            <div class="collapse @(advancedHasValue ? "show" : "")" id="advancedOptions">
                                <div class="advanced-content">
                                    <!-- Tankstellenmarke & Rabatt -->
                                    <div class="row gx-3 mb-3">
                                        <div class="col-md-6 mb-3 mb-md-0">
                                            <label for="stationBrand" class="section-label">Tankstellenmarke</label>
                                            <input type="text" id="stationBrand" name="StationBrand" class="form-control"
                                                   placeholder="z.B. Shell, Aral" value="@Model.StationBrand" />
                                        </div>
                                        <div class="col-md-6">
                                            <label for="discountPercent" class="section-label">
                                                Rabatt (%/€)
                                                <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                                      title="Verwende % für prozentuale Rabatte oder ohne Suffix für Festbeträge.">ⓘ</span>
                                            </label>
                                            <input type="text" id="discountPercent" name="DiscountPercentOrAbsolute" class="form-control"
                                                   placeholder="z.B. 30% oder 20" min="0" value="@Model.DiscountPercentOrAbsolute" />
                                        </div>
                                    </div>

                                    <!-- Fahrzeug & Kosten pro KM -->
                                    <div class="row gx-3">
                                        <div class="col-md-6 mb-3 mb-md-0 position-relative">
                                            <label for="CarType" class="section-label">
                                                Fahrzeug
                                                <a href="https://www.adac.de/rund-ums-fahrzeug/auto-kaufen-verkaufen/autokosten/uebersicht/"
                                                   target="_blank" class="small fw-normal">
                                                    (ADAC Vorschlag)</a><sup><a href="#fn1" id="ref1">1</a></sup>
                                            </label>
                                            <input type="text" class="form-control" id="CarType" placeholder="Fahrzeug suchen..."
                                                   list="CarTypeList" value="@Model.SelectedCarType" asp-for="SelectedCarType">
                                            <div id="suggestions" class="suggestions-box"></div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="PricePerKm" class="section-label">
                                                Kosten pro Kilometer (€)
                                                <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                                      title="Durchschnittliche Kosten pro Kilometer. Für Vorschläge nutze die Fahrzeugsuche.">ⓘ</span>
                                            </label>
                                            <input type="number" class="form-control" id="PricePerKm" name="PricePerKm" required
                                                   asp-for="PricePerKm" value="@Model.PricePerKm" step="any" min="0.01" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Internationaler Öl-Preis -->
                        @if (Model.OilPriceChange!=null && Model.OilPriceChange?.CurrentPrice != 0){
                        <div class="mb-3">
                            <button class="advanced-toggle" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#internationalOilPrice"
                                    aria-expanded="false"
                                    aria-controls="internationalOilPrice">
                                <span>Internationaler Öl-Preis</span>
                                <span class="arrow-indicator">▼</span>
                            </button>

                            <div class="collapse" id="internationalOilPrice">
                                <div class="advanced-content">
                                    <div class="oil-trend-section">
                                        <div class="oil-trend-header">
                                            <span class="oil-trend-title">Rohöl (Brent)</span>
                                            <span class="oil-trend-price">@Model.OilPriceChange?.DisplayCurrentPriceWithCurrency() / Barrel</span>
                                        </div>

                                        @{
                                            string TrendClass(double value) => value < 0 ? "is-down" : "is-up";
                                            string TrendIcon(double value) => value < 0 ? "ti-trending-down" : "ti-trending-up";
                                        }

                                        <div class="oil-trend-grid">
                                            <div class="oil-trend-card">
                                                <div class="oil-trend-period">Täglich</div>
                                                <div class="oil-trend-value @TrendClass(Model.OilPriceChange.Day)">
                                                    @Model.OilPriceChange.DisplayDayChangeWithSign()
                                                </div>
                                                <div class="oil-trend-sub">ggü. gestern</div>
                                            </div>

                                            <div class="oil-trend-card">
                                                <div class="oil-trend-period">Wöchentlich</div>
                                                <div class="oil-trend-value @TrendClass(Model.OilPriceChange.Week)">
                                                    @Model.OilPriceChange.DisplayWeekChangeWithSign()
                                                </div>
                                                <div class="oil-trend-sub">ggü. Vorwoche</div>
                                            </div>

                                            <div class="oil-trend-card">
                                                <div class="oil-trend-period">Monatlich</div>
                                                <div class="oil-trend-value @TrendClass(Model.OilPriceChange.Month)">
                                                    @Model.OilPriceChange.DisplayMonthChangeWithSign()
                                                </div>
                                                <div class="oil-trend-sub">ggü. Vormonat</div>
                                            </div>
                                        </div>

                                        <div class="oil-trend-note">
                                            <span>
                                                <i class="ti ti-clock" aria-hidden="true"></i>
                                                Letzte Aktualisierung: @Model.OilPriceChange.LastUpdated?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") Uhr
                                            </span>
                                            <span>
                                                <i class="ti ti-info-circle" aria-hidden="true"></i>
                                                Spritpreise können dem Rohölpreis folgen, sind aber von weiteren Faktoren abhängig. Trend ist nur eine Schätzung, zur Orientierung, kein Kaufsignal.
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>                       
                        }
                        else
                        {
                            <p>Ölpreisdaten momentan nicht verfügbar.</p> 
                        }

                        <!-- ==================================================
                             MODE-DIV: OPTIMALE SUCHE (enthält Tankmenge + Submit)
                             ================================================== -->
                        <div id="autoInputFields" class="modeStyle" style="display:@(Model.SelectInputMode == InputMode.auto ? "block" : "none")">

                            <!-- Standort -->
                            <div class="mb-3">
                                <label for="generalLocation" class="section-label">Standort</label>
                                <div class="input-group">
                                    <input type="text" id="generalLocationInput" class="form-control"
                                           placeholder="PLZ, Straße oder Ort eingeben" asp-for="Place" value="@Model.Place">
                                    <button id="geoButton" class="btn btn-primary location-btn" type="button" title="Aktuellen Standort verwenden">
                                        <img src="location.png" alt="Standort">
                                    </button>
                                </div>
                            </div>

                            <!-- Radius -->
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-1">
                                    <label class="section-label mb-0">Suchradius</label>
                                    <div class="flex-grow-1 text-center">
                                        <output id="radiusValue" class="value-output">10 km</output>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted ms-1">1</small>
                                    <div class="slider-container flex-grow-1 d-flex align-items-center">
                                        <input type="range" id="generalRadius" class="form-range custom-range"
                                               min="1" max="25" step="1" asp-for="Radius" />
                                    </div>
                                    <small class="text-muted ms-1">25 km</small>
                                </div>
                            </div>

                            <!-- TANKMENGE (nur für Optimale Suche) -->
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-1">
                                    <label for="fuelAmount" class="section-label mb-0">
                                        Tankmenge
                                    </label>
                                    <span class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                          title="Nutze das Textfeld für die maximale Tankmenge und den Slider für die aktuelle Tankmenge. Bei 0 wird nach Spritpreisen sortiert.">
                                        ⓘ
                                    </span>
                                    <div class="flex-grow-1 text-center">
                                        <span class="value-output" id="fuelAmountValue">@Model.FuelAmount + "l"</span>
                                    </div>
                                </div>
                                <div class="fuel-slider-wrap">
                                    <div class="flex-grow-1 position-relative" style="min-width: 0;">
                                        <div style="position: relative; height: 16px;">
                                            <small style="position: absolute; left: 10px; transform: translateX(-50%); color: var(--text-color); opacity: 0.5;">0</small>
                                            <small style="position: absolute; left: calc(25% - 2.5px); transform: translateX(-50%); color: var(--text-color); opacity: 0.5;">¼</small>
                                            <small style="position: absolute; left: calc(50%); transform: translateX(-50%); color: var(--text-color); opacity: 0.5;">½</small>
                                            <small style="position: absolute; left: calc(75% + 2.5px); transform: translateX(-50%); color: var(--text-color); opacity: 0.5;">¾</small>
                                            <small style="position: absolute; left: calc(100% - 10px); transform: translateX(-50%); color: var(--text-color); opacity: 0.5;">max</small>
                                        </div>
                                        <input type="range"
                                               name="FuelAmount"
                                               class="form-range"
                                               min="0" max="25" step="0.5"
                                               id="FuelAmountRange"
                                               style="width: 100%; padding: 0;">
                                    </div>
                                    <input type="number"
                                           id="MaximumFuelAmount"
                                           class="form-control"
                                           value="@Model.FuelAmount"
                                           title="Maximale Tankmenge" />
                                </div>
                            </div>

                            <!-- SUBMIT: TANKSTELLEN SUCHEN -->
                            <button type="submit" class="btn btn-primary submit-btn"
                                    asp-page-handler="Search" id="SearchBtn">
                                Tankstellen suchen
                                <div class="loader" id="loader-search"></div>
                            </button>
                        </div>

                        <!-- ==================================================
                             MODE-DIV: STANDORTVERGLEICH (enthält Submit)
                             ================================================== -->
                        <div id="manualInputFields" class="modeStyle" style="display:@(Model.SelectInputMode == InputMode.man ? "block" : "none")">

                            @if ((bool)Model.NamePlaces?.Any() || string.IsNullOrWhiteSpace(Model.NamePlaces[0]))
                            {
                                <!-- Standort 1 (KORRIGIERT: beide col-md-6 innerhalb der row) -->
                                <div class="location-row">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-6">
                                            <label class="section-label mb-1">Standort 1</label>
                                            <div class="input-group">
                                                <input type="text"
                                                       name="NamePlaces[0]"
                                                       class="form-control"
                                                       id="FirstComparePlace"
                                                       value="@(Model.NamePlaces.Count > 0 ? Model.NamePlaces[0] : "")"
                                                       placeholder="Ort eingeben" />
                                                <button id="geoButton2" class="btn btn-primary location-btn" type="button">
                                                    <img src="location.png" alt="Standort">
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="d-flex align-items-center mb-1">
                                                <label for="RadiusPlace0" class="section-label mb-0">Radius</label>
                                                <div class="flex-grow-1 text-center" id="RadiusPlace0Lbl">
                                                    <output id="outputRadius0" class="value-output">
                                                        @(Model.RadiusPlaces.Count > 0 ? Model.RadiusPlaces[0] : 10) km
                                                    </output>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <small class="text-muted ms-1">1</small>
                                                <div class="flex-grow-1">
                                                    <input type="range"
                                                           name="RadiusPlaces[0]"
                                                           class="form-range"
                                                           min="1" max="25" step="1"
                                                           value="@(Model.RadiusPlaces.Count > 0 ? Model.RadiusPlaces[0] : 10)"
                                                           id="RadiusPlace0">
                                                </div>
                                                <small class="text-muted ms-1">25</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Standort 2 -->
                                <div class="location-row">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-6">
                                            <label class="section-label mb-1">Standort 2</label>
                                            <input type="text"
                                                   name="NamePlaces[1]"
                                                   class="form-control"
                                                   value="@(Model.NamePlaces.Count > 1 ? Model.NamePlaces[1] : "")"
                                                   placeholder="Ort eingeben" 
                                                   id ="SecondComparePlace"/>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="d-flex align-items-center mb-1">
                                                <label for="RadiusPlace1" class="section-label mb-0">Radius</label>
                                                <div class="flex-grow-1 text-center" id="RadiusPlace1Lbl">
                                                    <output id="outputRadius1" class="value-output">
                                                        @(Model.RadiusPlaces.Count > 1 ? Model.RadiusPlaces[1] : 10) km
                                                    </output>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <small class="text-muted ms-1">1</small>
                                                <div class="flex-grow-1">
                                                    <input type="range"
                                                           name="RadiusPlaces[1]"
                                                           class="form-range"
                                                           min="1" max="25" step="1"
                                                           value="@(Model.RadiusPlaces.Count > 1 ? Model.RadiusPlaces[1] : 10)"
                                                           id="RadiusPlace1">
                                                </div>
                                                <small class="text-muted ms-1">25</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.NamePlaces.Count > 2)
                            {
                                @for (int i = 2; i < Model.NamePlaces.Count; i++)
                                {
                                    <div class="location-row">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-6">
                                                <label class="section-label mb-1">Standort @(i+1)</label>
                                                <input type="text"
                                                       name="NamePlaces[@i]"
                                                       class="form-control"
                                                       value="@Model.NamePlaces[i]"
                                                       placeholder="Ort eingeben" />
                                            </div>
                                            <div class="col-md-6">
                                                <div class="d-flex align-items-center mb-1">
                                                    <label class="section-label mb-0">Radius</label>
                                                    <div class="flex-grow-1 text-center">
                                                        <output id="outputRadius@(i)" class="value-output">
                                                            @(Model.RadiusPlaces.Count > i ? Model.RadiusPlaces[i] : 10) km
                                                        </output>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <small class="text-muted ms-1">1</small>
                                                    <div class="flex-grow-1">
                                                        <input type="range"
                                                               name="RadiusPlaces[@i]"
                                                               class="form-range"
                                                               min="1" max="25" step="1"
                                                               value="@(Model.RadiusPlaces.Count > i ? Model.RadiusPlaces[i] : 10)"
                                                               id="RadiusPlace@(i)"
                                                               data-output-id="outputRadius@(i)">
                                                    </div>
                                                    <small class="text-muted ms-1">25</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                            <div id="dynamicLocations"></div>

                            <div class="text-center mt-3 mb-3">
                                <button type="button" id="addStandort" class="btn btn-primary"
                                        @(Model.NamePlaces.Count >= 4 ? "disabled" : "")>
                                    @(Model.NamePlaces.Count >= 4 ? "Maximale Standorte erreicht" : "+ Standort hinzufügen")
                                </button>
                            </div>

                            <!-- SUBMIT: PREISE VERGLEICHEN -->
                            <button type="submit" class="btn btn-primary submit-btn"
                                    asp-page-handler="CalculateAverageCost" id="compareLocations">
                                Preise vergleichen
                                <div class="loader" id="loader-compare"></div>
                            </button>
                        </div>

                    </div>
                </div>

                <!-- ERGEBNIS-CARD: OPTIMALE SUCHE -->
                <div id="autoResults" style="display:@(Model.SelectInputMode == InputMode.auto ? "block" : "none")">
                    @if (Model.CheapestResultStations.Any())
                    {
                        <div class="card results-card mb-4">
                            <div class="card-body p-4">
                                <div class="mb-3 d-flex flex-wrap align-items-center gap-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <label for="viewMode" class="form-label mb-0 fw-semibold">Ansicht</label>
                                        <div id="viewModeCustom" class="custom-select">
                                            <div class="select-trigger">
                                                <span id="selectedValue">Liste</span>
                                                <span class="arrow">▼</span>
                                            </div>
                                            <div id="optionsList" class="suggestions-box">
                                                <div class="suggestion-item" data-value="list">Liste</div>
                                                <div class="suggestion-item" data-value="map">Karte</div>
                                            </div>
                                        </div>
                                        @if (Model.FuelAmount > 0)
                                        {
                                            <span id="listTooltip" class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                                  title="Die Wegkosten werden für Hin- und Rückfahrt angesetzt">ⓘ</span>
                                        }
                                        <span id="mapTooltip" class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                              title="Für Routenplanung via Google Maps klicke auf die Markierung der Tankstelle" style="display: none;">ⓘ</span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 ms-md-auto">
                                        <label for="sortMode" class="form-label mb-0 fw-semibold" id="sortLabel">
                                            Sortierung <span class="sort-arrow">↓</span>
                                        </label>
                                        <div id="sortModeCustom" class="custom-select">
                                            <div class="select-trigger">
                                                <span id="selectedSortValue">
                                                    @if (Model.FuelAmount > 0)
                                                    {
                                                        <text>Gesamtkosten</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Preis pro Liter</text>
                                                    }
                                                </span>
                                                <span class="arrow">▼</span>
                                            </div>
                                            <div id="sortOptionsList" class="suggestions-box">
                                                @if (Model.FuelAmount > 0)
                                                {
                                                    <div class="suggestion-item" data-value="totalCost">Gesamtkosten</div>
                                                    <div class="suggestion-item" data-value="fuelPrice">Preis pro Liter</div>
                                                    <div class="suggestion-item" data-value="distance">Entfernung</div>
                                                }
                                                else
                                                {
                                                    <div class="suggestion-item" data-value="fuelPrice">Preis pro Liter</div>
                                                    <div class="suggestion-item" data-value="distance">Entfernung</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="stationListContainer">
                                    @await Html.PartialAsync("_StationListPartial", Model)
                                    @{ TempData.Keep("StationsJson"); TempData.Keep("FuelAmount"); }
                                </div>
                                <div id="mapView" style="display: none;">
                                    <div id="map_div" class="map" style="height: 500px;"></div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.SearchExecuted)
                    {
                        <div class="card results-card mb-4">
                            <div class="card-body p-4 text-center">
                                <label id="noOpenStations">Keine offene Tankstelle im gewählten Radius gefunden</label>
                            </div>
                        </div>
                    }
                </div>

                <!-- ERGEBNIS-CARD: STANDORTVERGLEICH -->
                @if (Model.SelectInputMode == InputMode.man && Model.CalculatedAverageCosts.Any())
                {
                    <div id="averageCost" class="card results-card mb-4">
                        <div class="card-body p-4 text-center">
                            <h3 class="h3-summary mb-3">Durchschnittspreise</h3>
                            @{ int index = 0; }
                            @foreach (KeyValuePair<string, decimal> place in Model.CalculatedAverageCosts.OrderBy(p => p.Value))
                            {
                                <p class="mb-2" id="compareLocationItem-@index">
                                    @place.Key:
                                    @(place.Value > 0 ? $"{Model.ToDisplay(place.Value.ToString("0.000"))} €" : "Keine Preise verfügbar")
                                </p>
                                index++;
                            }
                        </div>
                    </div>
                }

            </div>
        </div>
    </form>

    <!-- FOOTNOTE -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <hr>
            <ol class="footer-note">
                <li id="fn1">@Model.DataSourceDate</li>
            </ol>
        </div>
    </div>
</div>

<script>
    let mapInitialized = false;
    let map;
    let Tiles;
    let locationIndex = @Model.NamePlaces.Count;

    function updateFuel(value) {
        document.getElementById('fuelAmountValue').textContent = String(value).replace('.', ',') + ' l';
    }

    function updateMax(value) {
        document.getElementById('FuelAmountRange').max = value;
        localStorage.setItem("maxVolume", value);
    }

    function toggleInputMethod(radio) {
        var manualFields = document.getElementById("manualInputFields");
        var autoFields = document.getElementById("autoInputFields");
        var averageCost = document.getElementById("averageCost");
        var autoResults = document.getElementById("autoResults");

        // Tab-Styling aktualisieren
        document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
        const label = document.querySelector(`label[for="${radio.id}"]`);
        if (label) label.classList.add('active');

        if (radio.value === "man") {
            manualFields.style.display = "block";
            autoFields.style.display = "none";
            if (autoResults) autoResults.style.display = "none";
            if (averageCost != null) averageCost.style.display = "block";
        }
        if (radio.value === "auto") {
            manualFields.style.display = "none";
            autoFields.style.display = "block";
            if (autoResults) autoResults.style.display = "block";
            if (averageCost != null) averageCost.style.display = "none";
        }
    }

    function toggleDetails(element) {
        var details = element.nextElementSibling;
        if (details.style.display === "none" || details.style.display === "") {
            details.style.display = "block";
        } else {
            details.style.display = "none";
        }
    }

    function formatAndSavePricePerKm(input) {
        let expression = input.value.replace(",", ".");
        document.getElementById("PricePerKm").value = expression;
        localStorage.setItem("pricePerKm", expression);
    }

    function saveFuelType(input) {
        localStorage.setItem("selectedFuelType", input.value);
    }

    $(function () {
        let debounceTimer = null;
        const $input = $("#CarType");
        const $suggestionsBox = $("#suggestions");

        $input.on('input', function () {
            clearTimeout(debounceTimer);
            const searchTerm = $(this).val().trim();
            $suggestionsBox.empty().hide();

            debounceTimer = setTimeout(function () {
                if (searchTerm.length > 0) {
                    $.ajax({
                        url: '?handler=FilterCarTypes',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: searchTerm },
                        success: function (data) {
                            data.filteredCars.forEach(car => {
                                const item = $('<div class="suggestion-item"></div>').text(car);
                                $suggestionsBox.append(item);
                            });
                            if (data.filteredCars.length > 0) {
                                $suggestionsBox.show();
                            }
                        },
                        error: function () {
                            console.error("Fehler bei der Filterabfrage");
                        }
                    });
                }
            }, 300);
        });

        $suggestionsBox.on('click', '.suggestion-item', function () {
            const selectedCarType = $(this).text();
            $input.val(selectedCarType);
            $suggestionsBox.empty().hide();
            if (selectedCarType === "") {
                $('#PricePerKm').val('');
                return;
            }

            $.ajax({
                url: '?handler=PricePerKm',
                type: 'GET',
                data: { carType: selectedCarType },
                success: function (data) {
                    $('#PricePerKm').val(data.pricePerKm);
                    localStorage.setItem("pricePerKm", data.pricePerKm);
                },
                error: function () {
                    console.error("Fehler beim Abrufen von PricePerKm");
                }
            });
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#suggestions, #CarType').length) {
                $suggestionsBox.empty().hide();
            }
        });
    });

    $(function () {
        var type = '@TempData["ToastType"]';
