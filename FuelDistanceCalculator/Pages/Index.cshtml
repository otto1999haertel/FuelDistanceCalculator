                                        oninput="document.getElementById('outputRadius0').textContent = this.value + ' km'">
                                </div>

                                <small class="text-muted ms-1">25 km</small>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 align-items-start">

                        <!-- Standort 2 -->
                        <div class="col-md-5 offset-md-1">
                            <label class="form-label mb-0">Standort 2</label>

                            <input type="text"
                                name="NamePlaces[1]"
                                class="form-control"
                                value="@(Model.NamePlaces.Count > 1 ? Model.NamePlaces[1] : "")"
                                placeholder="Geben Sie einen Ort ein" />
                        </div>

                        <!-- Radius 2 -->
                        <div class="col-md-5">

                            <div class="d-flex align-items-center mb-1">
                                <label for="RadiusPlace1" class="form-label mb-0">Radius</label>

                                <div class="flex-grow-1 text-center">
                                    <output id="outputRadius1" class="value-output">
                                        @(Model.RadiusPlaces.Count > 1 ? Model.RadiusPlaces[1] : 10) km
                                    </output>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 mt-1">
                                <small class="text-muted ms-1">1 km</small>

                                <div class="flex-grow-1">
                                    <input type="range"
                                        name="RadiusPlaces[1]"
                                        class="form-range"
                                        min="1" max="25" step="1"
                                        value="@(Model.RadiusPlaces.Count > 1 ? Model.RadiusPlaces[1] : 10)"
                                        id="RadiusPlace1"
                                        oninput="document.getElementById('outputRadius1').textContent = this.value + ' km'">
                                </div>

                                <small class="text-muted ms-1">25 km</small>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.NamePlaces.Count > 2)
                {
                    @for (int i = 2; i < Model.NamePlaces.Count; i++)
                    {
                        <div class="row g-3 align-items-start">

                        <!-- Standort 2 -->
                        <div class="col-md-5 offset-md-1">
                            <label class="form-label mb-0">Standort @(i+1)</label>

                            <input type="text"
                                name="NamePlaces[@i]"
                                class="form-control"
                                value="@Model.NamePlaces[i]"
                                placeholder="Geben Sie einen Ort ein" />
                        </div>

                        <!-- Radius 2 -->
                        <div class="col-md-5">

                            <div class="d-flex align-items-center mb-1">
                                <label class="form-label mb-0">Radius</label>

                                <div class="flex-grow-1 text-center">
                                    <output id="outputRadius@(i)" class="value-output">
                                        @(Model.RadiusPlaces.Count > i ? Model.RadiusPlaces[i] : 10) km
                                    </output>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 mt-1">
                                <small class="text-muted ms-1">1 km</small>

                                <div class="flex-grow-1">
                                    <input type="range"
                                        name="RadiusPlaces[@i]"
                                        class="form-range"
                                        min="1" max="25" step="1"
                                        value="@(Model.RadiusPlaces.Count > i ? Model.RadiusPlaces[i] : 10)"
                                        id="RadiusPlace@(i)"
                                        oninput="document.getElementById('outputRadius@(i)').textContent = this.value + ' km'">
                                </div>

                                <small class="text-muted ms-1">25 km</small>
                            </div>
                        </div>
                    </div>
                    }
                }

            <div id="dynamicLocations" class="row g-3 align-items-start"></div>

            <div class="row justify-content-center mt-3">
                <button type="button" id="addStandort" class="btn btn-primary" style="width: 200px"
                    onclick="addLocation()" @(Model.NamePlaces.Count >= 4 ? "disabled" : "")>
                    @(Model.NamePlaces.Count >= 4 ? "Maximale Standorte erreicht" : "Standort hinzufügen")
                </button>
            </div>

            <div class="row justify-content-center mt-3">
                <button type="submit" class="btn btn-primary"
                        style="width: 200px; display: flex; align-items: center; justify-content: center; gap: 6px;"
                        asp-page-handler="CalculateAverageCost"
                        onclick="document.getElementById('loader-compare').style.display='inline-block'">
                    Preise Vergleichen
                    <div class="loader" id="loader-compare"></div>
                </button>
            </div>
        </div>

        <!-- Suche-Modus -->
        <div id="autoInputFields" class="modeStyle mt-2" style="display:@(Model.SelectInputMode == InputMode.auto ? "block" : "none")">
          <div class="row g-3" style="align-items: start;">
                <div class="col-md-5 offset-md-1">
                    <!-- Standort Label -->
                    <label for="generalLocation" class="form-label mb-1">Standort (PLZ/ Straße, Ort)</label>
                    <!-- Input -->
                    <div class="input-group">
                        <input type="text" id="generalLocation" class="form-control"
                            placeholder="Geben Sie einen Ort ein" asp-for="Place" value="@Model.Place">
                        <button id="geoButton" class="btn btn-primary btn-sm d-flex align-items-center justify-content-center locationButton" type="button">
                            <img src="location.png" alt="Standort">
                        </button>
                    </div>
                </div>

                <div class="col-md-5">
                    <!-- Zeile 1: Label -->
                    <div class="d-flex align-items-center mb-1">
                        <label class="form-label mb-0">Radius</label>
                        <div class="flex-grow-1 text-center">
                            <output id="radiusValue" class="value-output">10 km</output>
                        </div>
                    </div>
                    <!-- Zeile 3: Slider -->
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <small class="text-muted ms-1">1 km</small>
                        <div class="slider-container flex-grow-1 d-flex align-items-center">
                            <input type="range"
                                id="generalRadius"
                                class="form-range custom-range"
                                min="1" max="25" step="1"
                                asp-for="Radius" />
                        </div>
                        <small class="text-muted ms-1">25 km</small>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-center mt-3">
                <button type="submit" class="btn btn-primary"
                        style="width: 120px; display: flex; align-items: center; justify-content: center; gap: 6px;"
                        asp-page-handler="Search" id="SearchBtn"
                        onclick="document.getElementById('loader-search').style.display='inline-block'">
                    Suchen
                    <div class="loader" id="loader-search"></div>
                </button>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-6 p-3">
                    @if (Model.CheapestResultStations.Any())
                    {
                        <div class="mb-3 d-flex align-items-center gap-3">
                            <label for="viewMode" class="form-label mb-0 me-2">Ansicht</label>
                            <div id="viewModeCustom" class="custom-select">
                                <div class="select-trigger" onclick="toggleDropdown()">
                                    <span id="selectedValue">Liste</span>
                                    <span class="arrow">▼</span>
                                </div>
                                <div id="optionsList" class="suggestions-box">
                                    <div class="suggestion-item" data-value="list" onclick="selectOption(this)">Liste</div>
                                    <div class="suggestion-item" data-value="map" onclick="selectOption(this)">Karte</div>
                                </div>
                            </div>
                            @if (Model.FuelAmount > 0)
                            {
                                <span id="listTooltip" class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                     title="Die Wegkosten werden für Hin- und Rückfahrt angesetzte">
                                    ⓘ
                                </span>
                            }

                            <span id="mapTooltip" class="input-group-text-icon" data-bs-toggle="tooltip" data-bs-placement="auto"
                                title="Für Routenplanung via Google Maps klicke auf die Markierung der Tankstelle" style="display: none;">
                                ⓘ
                            </span>

                            <label for="sortMode" class="form-label mb-0 me-2" id="sortLabel">Aufsteigend sortieren nach</label>
                            <div id="sortModeCustom" class="custom-select">
                                <div class="select-trigger" onclick="toggleDropdownSort()">
                                    <span id="selectedSortValue">
                                        @if (Model.FuelAmount > 0)
                                        {
                                            <text>Gesamtkosten</text>
                                        }
                                        else
                                        {
                                            <text>Preis pro Liter</text>
                                        }
                                    </span>
                                    <span class="arrow">▼</span>
                                </div>
                                <div id="sortOptionsList" class="suggestions-box">
                                    @if (Model.FuelAmount > 0)
                                    {
                                        <div class="suggestion-item" data-value="totalCost" onclick="selectOptionSort(this)">Gesamtkosten</div>
                                        <div class="suggestion-item" data-value="fuelPrice" onclick="selectOptionSort(this)">Preis pro Liter</div>
                                        <div class="suggestion-item" data-value="distance" onclick="selectOptionSort(this)">Entfernung</div>
                                    }
                                    else
                                    {
                                        <div class="suggestion-item" data-value="fuelPrice" onclick="selectOptionSort(this)">Preis pro Liter</div>
                                        <div class="suggestion-item" data-value="distance" onclick="selectOptionSort(this)">Entfernung</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div id="stationListContainer">
                            @await Html.PartialAsync("_StationListPartial", Model)
                            @{ TempData.Keep("StationsJson"); TempData.Keep("FuelAmount"); }
                        </div>
                        <div id="mapView" style="display: none;">
                            <div id="map_div" class="map" style="height: 500px;" />
                        </div>
                    }
                    else if (@Model.SearchExecuted)
                    {
                        <label id="noOpenStations" style="display: block; text-align: center;">
                            Keine offene Tankstelle im gewählten Radius gefunden
                        </label>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

<!-- JavaScript für die Eingabe-Auswahl-Steuerung -->
    <script>
        let mapInitialized = false;
        let map;
        let Tiles;
        let locationIndex = @Model.NamePlaces.Count;

        function updateFuel(value) {
            document.getElementById('fuelAmountValue').textContent = value;
        }

        function updateMax(value) {
            document.getElementById('FuelAmountRange').max = value;
            localStorage.setItem("maxVolume", value);
        }

        function calculateAndStore(input) {
            try 
            {
                let expression = input.value.replace(",", ".").trim();
                input.value = 0;
                document.getElementById("FuelAmount").value = 0;

                if (!/^[0-9+\-*/().\s]*$/.test(expression)) return;

                const result = parseExpression(expression);

                if (!isNaN(result) && isFinite(result) && result >= 0) 
            {
                    input.value = result;
                    document.getElementById("FuelAmount").value = result;
                }
            } 
            catch (e) {
                console.error("Ungültiger Ausdruck:", e);
            }
        }

        // Rekursiver Descent Parser für +, -, *, /
        function parseExpression(expr) {
            const tokens = tokenize(expr);
            let pos = 0;

            function peek() { return tokens[pos]; }
            function consume() { return tokens[pos++]; }

            function parseAddSub() {
                let left = parseMulDiv();
                while (peek() === '+' || peek() === '-') {
                    const op = consume();
                    const right = parseMulDiv();
                    left = op === '+' ? left + right : left - right;
                }
                return left;
            }

            function parseMulDiv() {
                let left = parseUnary();
                while (peek() === '*' || peek() === '/') {
                    const op = consume();
                    const right = parseUnary();
                    if (op === '/' && right === 0) throw new Error("Division durch 0");
                    left = op === '*' ? left * right : left / right;
                }
                return left;
            }

            function parseUnary() {
                if (peek() === '-') {
                    consume();
                    return -parsePrimary();
                }
                return parsePrimary();
            }

            function parsePrimary() {
                const token = peek();
                if (token === '(') {
                    consume(); // '('
                    const val = parseAddSub();
                    if (consume() !== ')') throw new Error("Fehlende schließende Klammer");
                    return val;
                }
                if (token !== undefined && !isNaN(parseFloat(token))) {
                    consume();
                    return parseFloat(token);
                }
                throw new Error(`Unerwartetes Token: ${token}`);
            }

            return parseAddSub();
        }

        function tokenize(expr) {
            // Zerlegt "30*1.5+10" → ['30', '*', '1.5', '+', '10']
            const regex = /(\d+\.?\d*)|([+\-*/()])/g;
            const tokens = [];
            let match;
            while ((match = regex.exec(expr)) !== null) {
                tokens.push(match[0]);
            }
            return tokens;
        }

        function toggleInputMethod(radio) {
            var manualFields = document.getElementById("manualInputFields");
            var autoFields = document.getElementById("autoInputFields");
            var averageCost = document.getElementById("averageCost");
            if (radio.value === "man") {
                manualFields.style.display = "block";
                autoFields.style.display = "none";
                if (averageCost != null) {
                    averageCost.style.display = "block";
                }
            }
            if (radio.value === "auto") {
                manualFields.style.display = "none";
                autoFields.style.display = "block";
                if (averageCost != null) {
                    averageCost.style.display = "none";
                }
            }
        }

        function toggleDetails(element) {
            // Holen des Elements, das die Details enthält
            var details = element.nextElementSibling;

            // Wenn die Details sichtbar sind, verstecke sie, sonst zeige sie an
            if (details.style.display === "none" || details.style.display === "") {
                details.style.display = "block";
            } else {
                details.style.display = "none";
            }
        }

        function formatAndSavePricePerKm(input) {
            let expression = input.value.replace(",", ".");
            document.getElementById("PricePerKm").value = expression;
            localStorage.setItem("pricePerKm", expression);
        }

        function saveFuelType(input){
            localStorage.setItem("selectedFuelType", input.value);
        }

        $(function () {
            let debounceTimer = null;
            const $input = $("#CarType");
            const $suggestionsBox = $("#suggestions");

            // Input-Feld beobachten
            $input.on('input', function () {
                clearTimeout(debounceTimer);
                const searchTerm = $(this).val().trim();
                $suggestionsBox.empty().hide();

                debounceTimer = setTimeout(function () {
                    if (searchTerm.length > 0) {
                        $.ajax({
                            url: '?handler=FilterCarTypes',
                            type: 'GET',
                            dataType: 'json',
                            data: { query: searchTerm },
                            success: function (data) {
                                data.filteredCars.forEach(car => {
                                    const item = $('<div class="suggestion-item"></div>').text(car);
                                    $suggestionsBox.append(item);
                                });
                                if (data.filteredCars.length > 0) {
                                    $suggestionsBox.show();
                                }
                            },
                            error: function () {
                                console.error("Fehler bei der Filterabfrage");
                            }
                        });
                    }
                }, 300); // <-- Debounce von 300 ms
            });

            // Nur EIN zentraler Click-Handler für dynamische Vorschläge
            $suggestionsBox.on('click', '.suggestion-item', function () {
                const selectedCarType = $(this).text();
                $input.val(selectedCarType);
                $suggestionsBox.empty().hide();
                if (selectedCarType === "") {
                    $('#PricePerKm').val('');
                    return;
                }

                $.ajax({
                    url: '?handler=PricePerKm',
                    type: 'GET',
                    data: { carType: selectedCarType },
                    success: function (data) {
                        $('#PricePerKm').val(data.pricePerKm);
                        localStorage.setItem("pricePerKm", data.pricePerKm);
                    },
                    error: function () {
                        console.error("Fehler beim Abrufen von PricePerKm");
                    }
                });
            });

            // Click außerhalb der Box: Suggestions schließen
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#suggestions, #CarType').length) {
                    $suggestionsBox.empty().hide();
                }
            });
        });

        $(function () {
            var type = '@TempData["ToastType"]';
            var message = '@TempData["ToastMessage"]';

            if (message) {
                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: "toast-bottom-right" // ⬅️ hier wird die Position gesetzt
                };
                toastr[type](message);
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl)
            });
            const savedPricePerKm = localStorage.getItem("pricePerKm");
            if (savedPricePerKm) {
                // Nur überschreiben wenn Server keinen Wert geliefert hat
                $('#PricePerKm').val(savedPricePerKm);
            }

            const savedFuelType = localStorage.getItem("selectedFuelType");
            if (savedFuelType) {
                const radio = document.querySelector(`input[name="SelectedFuelType"][value="${savedFuelType}"]`);
                if (radio) {
                    radio.checked = true;
                }
            }

            const maxVolume = localStorage.getItem("maxVolume");
            if (maxVolume) {
                document.getElementById('MaximumFuelAmount').value = maxVolume;
                document.getElementById('FuelAmountRange').max = maxVolume;
            }

            document.getElementById("geoButton")?.addEventListener("click", getLocation);
            document.getElementById("geoButton2")?.addEventListener("click", getLocation);

            const slider = document.getElementById('generalRadius');
            const output = document.getElementById('radiusValue');
            
            if (slider && output) {
                output.textContent = slider.value + ' km';
                slider.addEventListener('input', () => {
                    output.textContent = slider.value + ' km';
                });
            }


        });

        function switchView(value) {
            const selected = value;
            document.getElementById("stationListContainer").style.display = selected === "list" ? "block" : "none";
            document.getElementById("mapView").style.display = selected === "map" ? "block" : "none";

            if (selected === "map") {
                if (!mapInitialized) {
                    initMap();
                    mapInitialized = true;
                }
                document.getElementById("mapTooltip").style.display = "inline-block";
                document.getElementById("sortLabel").style.display = "none";
                document.getElementById("sortModeCustom").style.display = "none";
            }
            else {
                document.getElementById("mapTooltip").style.display = "none";
                document.getElementById("sortLabel").style.display = "inline-block";
                document.getElementById("sortModeCustom").style.display = "inline-block";
                document.getElementById("listTooltip").style.display = "inline-block";
            }
        }

        function initMap() {
            var latitude = @Model.LatitudePlace.ToString().Replace(",", ".");
            var longitude = @Model.LongitudePlace.ToString().Replace(",", ".");
            map = L.map('map_div').setView([latitude, longitude], 12); // Zentrum (z. B. Erlangen)
            Tiles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap',
            });
            Tiles.addTo(map);
            const storedMode = localStorage.getItem("darkMode");
            const mapDiv = document.getElementById("map_div");
            if (storedMode === "dark" || (storedMode === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                mapDiv.classList.add("dark-map");
            } else {
                mapDiv.classList.remove("dark-map");
            }

            const defaultIcon = new L.Icon({
                iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
                shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                tooltipAnchor: [0, -32],
                shadowSize: [41, 41]
            });
            // Beispiel-Marker (dynamisch aus Razor erzeugt)
            const greenIcon = new L.Icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
                shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],      // Spitze des Icons (für Popup/Tooltip Position)
                tooltipAnchor: [0, -32],   // <<–– das ist entscheidend!
                shadowSize: [41, 41]
            });

                    @foreach (var station in Model.CheapestResultStations.Take(10))
                {
                    var lat = station.Coords.Lat.ToString().Replace(",", ".");
                    var lng = station.Coords.Lng.ToString().Replace(",", ".");
                    var price = Model.FuelAmount > 0
                    ? Model.ToDisplay(station.TotalCalculatedCoast.ToString())
                    : Model.ToDisplay(station.FuelTypePrice.ToString());

                    var isCheapest = station == Model.CheapestResultStations.First();

                    <text>
                        L.marker([@lat, @lng], {icon: @(isCheapest ? "greenIcon" : "defaultIcon") })
                        .addTo(map)
                        .bindTooltip(`@price €`, {permanent: true, direction: "top" })
                        .openTooltip()
                        .on('click',function(){
                            window.open("https://www.google.com/maps?q=@lat,@lng", "_blank");
                                                            });

                    </text>
            }
                }

        function getLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(sendPositionToServer, handleError);
            } else {
                toastr.warning("Geolocation wird nicht unterstützt.");
            }
        }

        async function sendPositionToServer(position) {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;

            const response = await fetch("?handler=UpdateLocation", {
                method: "POST",
                headers: { 
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify({ latitude: lat, longitude: lon })
            });

            if (response.ok) {
                const result = await response.json();
                if (result.success && result.address) {
                    if (document.getElementById("generalLocation")) {
                        document.getElementById("generalLocation").value = result.address;
                    }
                    if (document.getElementById("GeoStandort")) {
                        document.getElementById("GeoStandort").value = result.address;
                    }
                    if (document.getElementById("FirstComparePlace")) {
                        document.getElementById("FirstComparePlace").value = result.address;
                    }
                }
            } else {
                toastr.error("Serverfehler bei Standortabfrage.");
            }
        }

        function handleError(error) {
            switch (error.code) {
                case error.PERMISSION_DENIED:
                    toastr.warning("Nutzer hat die Standortfreigabe abgelehnt.");
                    break;
                case error.POSITION_UNAVAILABLE:
                    toastr.warning("Standortinformationen nicht verfügbar.");
                    break;
                case error.TIMEOUT:
                    toastr.warning("Standortabfrage hat zu lange gedauert.");
                    break;
                default:
                    toastr.warning("Unbekannter Fehler.");
            }
        }

        function addLocation() {
            const container = document.getElementById("dynamicLocations");
            if (locationIndex < 4) {
                const html = `
                     <div class="col-md-5 offset-md-1 mt-3 location-fade-in standort-col">
                        <label class="form-label mb-1">Standort ${locationIndex + 1}</label>

                        <input type="text" 
                            name="NamePlaces[${locationIndex}]" 
                            class="form-control" 
                            placeholder="Geben Sie einen Ort ein" />
                    </div>

                    <div class="col-md-5 mt-3 location-fade-in radius-col">

                        <div class="d-flex align-items-center mb-1">
                            <label class="form-label mb-0">Radius</label>
                            <div class="flex-grow-1 text-center">
                                <output id="outputRadius${locationIndex}" class="value-output">10 km</output>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-1">
                            <small class="text-muted ms-1">1 km</small>

                            <div class="flex-grow-1">
                                <input type="range"
                                    name="RadiusPlaces[${locationIndex}]"
                                    class="form-range custom-range"
                                    min="1" max="25" step="1"
                                    value="10"
                                    id="RadiusPlace${locationIndex}"
                                    oninput="document.getElementById('outputRadius${locationIndex}').textContent = this.value + ' km'" />
                            </div>

                            <small class="text-muted ms-1">25 km</small>
                        </div>

                    </div>`;
                
                container.insertAdjacentHTML("beforeend", html);
                locationIndex++;
            }

            if (locationIndex >= 4) {
                const button = document.getElementById("addStandort");
                button.disabled = true;
                button.classList.add("disabled");
                button.textContent = "Maximale Standorte erreicht";
            }
        }

        function sortList(sortValue) {
            const container = document.getElementById('stationListContainer');
            container.innerHTML = '<p>Sortiert...</p>';

            const validSortModes = ['fuelPrice', 'distance', 'totalCost'];
            if (!validSortModes.includes(sortValue)) {
                console.error('Ungültiger sortMode:', sortValue);
                container.innerHTML = '<p>Ungültiger Sortiermodus</p>';
                return;
            }

            const formData = new FormData();
            formData.append('sortMode', sortValue);

            fetch('?handler=Sort', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(text => { throw new Error(`HTTP ${response.status}: ${text}`); });
                }
                return response.text();
            })
            .then(html => {
                container.innerHTML = html;
                document.querySelectorAll('.station-summary').forEach(el => el.onclick = () => toggleDetails(el));
            })
            .catch(err => {
                console.error('Fehler:', err);
                container.innerHTML = '<p>Fehler: ' + err.message + '</p>';
            });
        }

        function toggleDropdown() {
            const optionsList = document.getElementById('optionsList');
            optionsList.style.display = optionsList.style.display === 'block' ? 'none' : 'block';
            }

        function selectOption(element) {
            const selectedValue = document.getElementById('selectedValue');
            selectedValue.textContent = element.textContent;
            const value = element.getAttribute('data-value');
            
            // Schließe das Dropdown
            document.getElementById('optionsList').style.display = 'none';
            
            // Rufe deine Original-Funktion auf (z. B. switchView() mit dem Wert)
            switchView(value); // Passe switchView() an, um den Wert als Parameter zu akzeptieren, falls nötig
            }



        function toggleDropdownSort() {
            const optionsList = document.getElementById('sortOptionsList');
            optionsList.style.display = optionsList.style.display === 'block' ? 'none' : 'block';
        }

        function selectOptionSort(element) {
            const selectedValue = document.getElementById('selectedSortValue');
            selectedValue.textContent = element.textContent;
            const value = element.getAttribute('data-value');
            
            // Schließe das Dropdown
            document.getElementById('sortOptionsList').style.display = 'none';
            
            // Rufe die Original-Sortierfunktion auf (unverändert)
            sortList(value);
        }

        // Optional: Schließe das Dropdown bei Klick außerhalb
        document.addEventListener('click', function(event) {
            const viewSelect = document.getElementById('viewModeCustom');
            if (viewSelect && !viewSelect.contains(event.target)) {
                document.getElementById('optionsList').style.display = 'none';
            }

            const sortSelect = document.getElementById('sortModeCustom');
            if (sortSelect && !sortSelect.contains(event.target)) {
                document.getElementById('sortOptionsList').style.display = 'none';
            }
        });

    </script>
