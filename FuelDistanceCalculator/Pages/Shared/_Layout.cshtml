<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="~/gas_station.ico">
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/darkmode.js"></script>
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <!-- jQuery (falls noch nicht vorhanden) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

     <!-- SEO -->
    <meta name="description" content="@(ViewData["Description"] ?? "FuelGo – Finde die günstigste Tankstelle in deiner Nähe oder vergleiche Spritkosten zwischen mehreren Orten. Kostenlos, ohne Anmeldung.")" />
    <meta name="keywords" content="günstige Tankstelle, Spritpreise vergleichen, Diesel günstig, Benzin Preisvergleich, Tankstelle finden" />
    <meta name="author" content="FuelGo" />
    <link rel="canonical" href="https://fuelgo.de@Context.Request.Path" />

    <!-- Open Graph (WhatsApp, Discord, Social Media Vorschau) -->
    <meta property="og:title" content="@ViewData["Title"] – FuelGo" />
    <meta property="og:description" content="Finde die optimale Tankstelle oder vergleiche Spritkosten zwischen mehreren Orten." />
    <meta property="og:url" content="https://fuelgo.de@ViewContext.HttpContext.Request.Path" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />

    <!-- JSON-LD Structured Data (Google versteht was die App macht) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebApplication",
      "name": "FuelGo",
      "url": "https://fuelgo.de",
      "description": "Tankstellen vergleichen und günstigste Spritpreise in Deutschland finden",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web, Android, iOS",
      "inLanguage": "de-DE",
      "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "EUR" }
    }
    </script>

</head>
<body>
    <div class="site">
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3" id="navbar">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">FuelGo</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <svg class="navbar-toggler-icon-svg" width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 7h22M4 15h22M4 23h22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-miterlimit="10"/>
                    </svg>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Contact">Kontakt</a>
                        </ul>
                        <!-- Dark Mode Toggle Button -->
                        <button id="autoDarkModeToggle" class="btn btn-primary mx-2">🤖 Auto</button>
                        <button id="darkModeToggle" class="btn btn-primary mx-2">🌙 Mode</button>
                    </div>
                </div>
            </nav>
        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer">
            <div class="container" id="Copyright">
                &copy; 2025 - @DateTime.Now.Year - FuelGo - <a asp-area="" asp-page="/Contact">Impressum</a>
            </div>
        </footer>

        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
        </div>
</body>
</html>