@using System.Globalization
@using FuelDistanceCalculator.Model
@using Microsoft.IdentityModel.Tokens
@model IndexModel

@if (Model.CheapestResultStations == null || !Model.CheapestResultStations.Any())
{
    <p>Keine Stationen gefunden.</p>
    return;
}
<div id="listView">
    @if (Model.FuelAmount > 0 && Model.SortMode.Equals(SortModeEnum.totalCost))
    {
        <div class="d-flex flex-column gap-2 align-items-start fw-medium mb-3" style="color: #8A9A7B;">
            @if (Model.SavingsToCheapestStation > 0)
            {
                <span id="savings-to-cheapest-station">
                    Ersparnis zum günstigsten Einzelpreis im Radius:
                    <strong>@Model.SavingsToCheapestStation.ToString().Replace('.', ',') €</strong>
                </span>
            }
            @if (Model.SavingsToNearestStation > 0)
            {
                <span id="savings-to-nearest-station">
                    Ersparnis zur Nächsten im Radius: <strong>@Model.SavingsToNearestStation.ToString().Replace('.', ',')
                    €</strong>
                </span>
            }
        </div>
    }
    <ul class="station-list">
        @{
            int index = 0;
        }
        @foreach (GasStation station in Model.CheapestResultStations.Take(10))
        {
            <li class="station-item">
                <div class="station-summary" id="station-summary-item-@index">
                    @if (!station.Brand.IsNullOrEmpty())
                    {
                        <span>@station.Brand</span>
                    }
                    else
                    {
                        <span>@station.Name</span>
                    }

                    @if (Model.FuelAmount > 0 || station.TotalCombinedCosts > 0)
                    {
                        <span>Gesamtkosten @if(station.DiscountApplied){
                                        <text>(inkl.
                                            Rabatt)</text>
                                        }: <span
                            class="station-strong-price">@Model.ToDisplayFloatingPoint(station.TotalCombinedCosts.ToString())
                            €</span></span>
                        }
                    else
                        {
                            <span>Einzelpreis pro Liter: <span
                                class="station-strong-price">@Model.ToDisplayFloatingPoint(station.FuelTypePrice.ToString())
                                €</span></span>
                            }
                        </div>
                        <div class="station-details" style="display:none;" id="station-details-item-@index">
                            @if (Model.FuelAmount > 0 || station.TotalCombinedCosts > 0)
                            {
                                <div id= "detailed-costs-@index" class="detailed-cost-container">
                                    <p class="detailed-cost-paragraph">Einzelpreis pro Liter:
                                        @Model.ToDisplayFloatingPoint(station.FuelTypePrice.ToString()) €</p>
                                        <p class="detailed-cost-paragraph">Kraftstoffkosten 
                                            @Model.ToDisplayFloatingPoint(@station.TotalFuelCost.ToString()) €</p>
                                            <p class="detailed-cost-paragraph">Reisekosten:
                                                @Model.ToDisplayFloatingPoint(@station.TotalTravelCost.ToString()) €</p>
                                </div>
                                        }
                                        @if (!string.IsNullOrEmpty(station.LastUpdate))
                                        {
                                            DateTimeOffset dto = DateTimeOffset.Parse(station.LastUpdate);
                                            <p id="lastUpdateDisplay-@index">
                                                Letzte Aktualisierung: @dto.ToString("HH:mm 'Uhr'", new CultureInfo("de-DE")) um
                                                <span style="color: @(station.UpdateAmount < 0 ? "#8A9A7B" : "#C85450")">
                                                    @station.DisplayUpdateAmount()
                                                </span>
                                            </p>
                                        }
                                        <p>
                                            Entfernung: @Model.ToDisplayFloatingPoint(station.Dist.ToString()) km
                                            @if (station.IsRoutingDistanceCalculated)
                                            {
                                                <small class="text-muted ms-1">via Routenberechnung</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted ms-1">via Luftlinie</small>
                                            }
                                        </p>
                                        <p>Ort:
                                            <a id="gMapsLinkLocation-@index" href="https://www.google.com/maps?q=@station.Place,@station.Street"
                                               target="_blank">
                                                @station.Place, @station.Street
                                            </a>
                                        </p>
                                        @if (!string.IsNullOrEmpty(station.ClosesAt))
                                        {
                                            DateTimeOffset dto = DateTimeOffset.Parse(station.ClosesAt);
                                            <p>Schließt um @dto.ToString("HH:mm 'Uhr'", new CultureInfo("de-DE"))</p>
                                        }
                        </div>
                                </li>
                                index++;
                            }
                        </ul>
                    </div>