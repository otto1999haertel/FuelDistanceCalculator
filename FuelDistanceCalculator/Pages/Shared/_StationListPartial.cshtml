@using System.Globalization
@using FuelDistanceCalculator.Model
@model IndexModel

@if (Model.CheapestResultStations == null || !Model.CheapestResultStations.Any())
{
    <p>Keine Stationen gefunden.</p>
    return;
}
<div id="listView">
    @if(Model.FuelAmount> 0 && Model.SortMode.Equals("totalCost")){
        <div class="d-flex flex-nowrap gap-3 align-items-center fw-medium mb-3" style="color: #2e8b57;">
        @if (Model.SavingsToCheapestStation > 0)
            {
                <span>
                    Erspranis zur Günstigsten: <strong>@Model.SavingsToCheapestStation €</strong>
                </span>
            }
            @if (Model.SavingsToNearestStation > 0)
            {
                <span>
                    Erspranis zur Nächsten: <strong>@Model.SavingsToNearestStation €</strong>
                </span>
            }
        </div>
    }
    <ul class="station-list">
        @foreach (GasStation station in Model.CheapestResultStations)
        {
            <li class="station-item">
                <div class="station-summary" onclick="toggleDetails(this)">
                    <strong>@station.Name</strong> -
                    @if (Model.FuelAmount > 0 || station.TotalCalculatedCoast>0)
                    {
                        <span>Gesamtkosten: @Model.ToDisplay(station.TotalCalculatedCoast.ToString()) €</span>
                    }
                    else
                    {
                        <span>Einzelpreis pro Liter: @Model.ToDisplay(station.FuelTypePrice.ToString()) €</span>
                    }
                </div>
                <div class="station-details" style="display:none;">
                    @if (Model.FuelAmount > 0 || station.TotalCalculatedCoast>0)
                    {
                        <p>Einzelpreis pro Liter: @Model.ToDisplay(station.FuelTypePrice.ToString()) €</p>
                    }
                    @if (!string.IsNullOrEmpty(station.LastUpdate))
                    {
                        DateTimeOffset dto = DateTimeOffset.Parse(station.LastUpdate);
                        <p>Letzte Aktualisierung: @dto.ToString("HH:mm 'Uhr'", new CultureInfo("de-DE"))</p>
                    }
                    <p>Entfernung: @Model.ToDisplay(station.Dist.ToString()) km</p>
                    <p>Ort:
                        <a href="https://www.google.com/maps?q=@station.Place,@station.Street" target="_blank">
                            @station.Place, @station.Street
                        </a>
                    </p>
                    @if (!string.IsNullOrEmpty(station.ClosesAt))
                    {
                        DateTimeOffset dto = DateTimeOffset.Parse(station.ClosesAt);
                        <p>Schließt um @dto.ToString("HH:mm 'Uhr'", new CultureInfo("de-DE"))</p>
                    }
                </div>
            </li>
        }
    </ul>
</div>